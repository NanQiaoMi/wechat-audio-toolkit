/** app.wxss **/
page {
  background-color: #F8F6F2;
  color: #1C1917;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Rounded", "SF Pro Display", "PingFang SC", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* Design Tokens */
:root {
  --color-canvas: #F8F6F2;
  --color-card: #FFFFFF;
  --color-primary-text: #1C1917;
  --color-secondary-text: #78716C;
  --color-accent: #FF6B00;
  --color-accent-soft: #FFF7ED;
  --color-success: #16A34A;
  --color-border: rgba(0, 0, 0, 0.06);
}

button {
  background: initial;
  padding: 0;
  margin: 0;
  border: none;
  font-family: inherit;
  line-height: inherit;
  box-sizing: border-box;
}

button:not([size='mini']) {
  width: 100%;
  margin-left: 0;
  margin-right: 0;
}

button:focus {
  outline: 0;
}

button::after {
  border: none;
}

/* -------------------------------------------------------------------------- */
/* 全局微交互：指尖拖拽悬浮时码气泡 (Scrubbing HUD Floating Time Bubble)        */
/* -------------------------------------------------------------------------- */
.scrubbing-time-bubble {
  position: absolute;
  top: -64rpx;
  transform: translateX(-50%);
  background: #1C1917;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Rounded", "SF Mono", Menlo, monospace;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.22);
  pointer-events: none;
  white-space: nowrap;
  z-index: 99;
  animation: bubblePop 0.15s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.scrubbing-time-bubble::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid #1C1917;
}

@keyframes bubblePop {
  0% {
    opacity: 0;
    transform: translateX(-50%) translateY(8rpx) scale(0.9);
  }
  100% {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1);
  }
}
