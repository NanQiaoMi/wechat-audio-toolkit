<!-- miniprogram/pages/record/record.wxml -->
<!-- 现场录音页（v5.1 · FR-30）：idle / recording / paused / review 四态 -->
<view class="page-record">

  <!-- 顶部品牌区 -->
  <view class="page-header">
    <view class="brand-tag">
      <text class="brand-dot"></text>
      <text class="brand-tag-text">RECORD</text>
    </view>
    <text class="brand-title">现场录音</text>
    <text class="brand-desc">麦克风直录 · 最长 10 分钟 · 录完即可转换或剪辑</text>
  </view>

  <!-- 异常提示卡（权限 / 隐私 / 录音失败） -->
  <view wx:if="{{errorText}}" class="error-card">
    <view class="error-head">
      <text class="error-icon">⚠️</text>
      <text class="error-title">{{errorTitle}}</text>
    </view>
    <text class="error-body">{{errorText}}</text>
    <view class="error-actions">
      <view wx:if="{{errorKind === 'auth'}}" class="error-btn" bindtap="onOpenSettings" hover-class="btn-hover">去设置</view>
      <view class="error-btn solid" bindtap="onRetryRecord" hover-class="btn-hover">重试录音</view>
    </view>
  </view>

  <!-- 主录音卡 -->
  <view class="card-panel">

    <!-- IDLE：点击开始录音 -->
    <view wx:if="{{status === 'idle'}}" class="idle-stage">
      <view class="record-orb" bindtap="onStartRecord" hover-class="record-orb-hover">
        <view class="record-orb-ring"></view>
        <text class="orb-icon">🎙️</text>
        <text class="orb-label">开始录音</text>
      </view>
      <text class="idle-hint">点击开始录音</text>
      <text class="idle-sub">录音会使用本机麦克风，首次使用需授权</text>
      <view class="spec-row">
        <text class="spec-chip">PCM 高保真 · 16kHz</text>
        <text class="spec-chip">原声直录 · 实时声波</text>
        <text class="spec-chip">最长 10 分钟</text>
      </view>
    </view>

    <!-- RECORDING：实时物理波形 + 分贝计 + 计时 + 暂停/完成 -->
    <view wx:elif="{{status === 'recording'}}" class="active-stage">
      <view class="stage-top-meta">
        <view class="status-pill live">
          <view class="live-dot"></view>
          <text>正在录音</text>
        </view>
        <view class="live-decibel-pill {{liveDecibelLevel}}">
          <text class="live-decibel-icon">🎙️</text>
          <text class="live-decibel-val">{{liveDecibelText}}</text>
          <text class="live-decibel-desc">· {{liveDecibelStatus}}</text>
        </view>
      </view>

      <text class="timer-display">{{elapsedText}}</text>

      <!-- 实时滚动声波谱线 (28 柱真实振幅能量) -->
      <view class="live-wave-stage">
        <view class="live-wave-spectrum">
          <view
            wx:for="{{liveWaveBars}}"
            wx:key="id"
            class="live-spectrum-bar"
            style="height: {{item.height}}rpx; opacity: {{item.opacity}};"
          ></view>
        </view>
        <view class="live-wave-baseline"></view>
      </view>

      <text class="active-hint">正在现场拾音 · 随时可点「暂停」即刻试听回放</text>

      <view class="control-row">
        <view class="ctrl-btn ghost" bindtap="onPauseRecord" hover-class="btn-hover">
          <text class="ctrl-icon">⏸</text>
          <text>暂停并试听</text>
        </view>
        <view class="ctrl-btn finish" bindtap="onFinishRecord" hover-class="btn-hover">
          <text class="ctrl-icon">✓</text>
          <text>完成录音</text>
        </view>
      </view>
    </view>

    <!-- PAUSED / INTERRUPTED：中断保留 + 随时即时回放试听 + 继续/完成 -->
    <view wx:elif="{{status === 'paused'}}" class="active-stage paused-stage">
      <view class="stage-top-meta">
        <view class="status-pill paused">
          <view class="live-dot"></view>
          <text>{{interrupted ? '系统中断挂起' : '录音已挂起'}}</text>
        </view>
        <text class="paused-dur-badge">已录 {{elapsedText}}</text>
      </view>

      <!-- 系统来电/语音中断提示 -->
      <view wx:if="{{interrupted}}" class="interruption-alert-card">
        <text class="interruption-alert-icon">⚠️</text>
        <view class="interruption-alert-body">
          <text class="interruption-alert-title">录音被电话/系统通话打断</text>
          <text class="interruption-alert-sub">已为您安全保留前 {{elapsedText}} 录音，可立即试听回放或继续追加录音</text>
        </view>
      </view>

      <!-- 中断即刻回放播放器 -->
      <view class="paused-audition-card">
        <view class="paused-audition-header">
          <view class="audition-header-left">
            <text class="audition-icon">🎧</text>
            <text class="audition-title">已录片段即刻回放</text>
          </view>
          <text class="audition-dur-pill">{{pausedDurationText || elapsedText}}</text>
        </view>

        <view class="paused-player-body">
          <view class="paused-play-btn {{pausedIsPlaying ? 'playing' : ''}}" bindtap="onTogglePausedPreview" hover-class="btn-hover">
            <text class="paused-play-icon">{{pausedIsPlaying ? '⏸' : '▶'}}</text>
          </view>
          <view class="paused-slider-column">
            <slider
              class="paused-slider"
              min="0"
              max="{{pausedDuration || 1}}"
              value="{{pausedSliderValue}}"
              step="0.1"
              block-size="14"
              activeColor="#FF6B00"
              backgroundColor="#EAE6DF"
              bindchange="onPausedPreviewSeek"
            />
            <view class="paused-time-meta">
              <text>{{pausedCurrentText}}</text>
              <text>{{pausedDurationText || elapsedText}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 声波定格预览 -->
      <view class="live-wave-stage frozen">
        <view class="live-wave-spectrum">
          <view
            wx:for="{{liveWaveBars}}"
            wx:key="id"
            class="live-spectrum-bar frozen"
            style="height: {{item.height}}rpx; opacity: 0.45;"
          ></view>
        </view>
        <view class="live-wave-baseline"></view>
      </view>

      <view class="control-row paused-actions">
        <view class="ctrl-btn ghost accent" bindtap="onResumeRecord" hover-class="btn-hover">
          <text class="ctrl-icon">▶</text>
          <text>继续录音</text>
        </view>
        <view class="ctrl-btn finish" bindtap="onFinishRecord" hover-class="btn-hover">
          <text class="ctrl-icon">✓</text>
          <text>完成录音</text>
        </view>
      </view>

      <view class="paused-discard-link" bindtap="onRestartRecord">放弃此段并重录</view>
    </view>

    <!-- REVIEW：试听 + 去向 -->
    <view wx:elif="{{status === 'review'}}" class="review-stage">
      <view class="status-pill done">
        <view class="live-dot"></view>
        <text>录制完成</text>
      </view>

      <view class="review-file">
        <view class="file-emoji">🎧</view>
        <view class="file-meta">
          <text class="file-name">{{fileName}}</text>
          <text class="file-spec">{{durationText}} · {{sizeText}} · 高保真原声</text>
        </view>
      </view>

      <view class="preview-player">
        <view class="player-toggle {{isPlaying ? 'playing' : ''}}" bindtap="onTogglePreview" hover-class="btn-hover">
          <text>{{isPlaying ? '⏸' : '▶'}}</text>
        </view>
        <view class="player-slider-wrap">
          <slider
            class="player-slider"
            min="0"
            max="{{previewDuration || 1}}"
            value="{{previewValue}}"
            step="0.1"
            block-size="14"
            activeColor="#FF6B00"
            backgroundColor="#E7E5E4"
            bindchange="onPreviewSeek"
          />
          <view class="player-time-row">
            <text class="player-time">{{previewCurrentText}}</text>
            <text class="player-time">{{previewDurationText}}</text>
          </view>
        </view>
      </view>

      <text class="review-hint">{{fromSource === 'editor' ? '推荐去向：音乐剪辑 · 导入后可继续裁剪' : '推荐去向：格式转换 · 返回首页即可开始'}}</text>

      <view class="action-col">
        <view class="primary-action" bindtap="onGoConvert" hover-class="btn-hover">
          <text>⚡</text>
          <text>去转换</text>
        </view>
        <view class="secondary-action" bindtap="onGoEditor" hover-class="btn-hover">
          <text>✂️</text>
          <text>去剪辑</text>
        </view>
        <view class="ghost-action" bindtap="onRestartRecord" hover-class="btn-hover">重新录制</view>
      </view>
    </view>

  </view>

  <!-- 底部说明 -->
  <view class="tips-card">
    <text class="tips-title">录音说明</text>
    <view class="tip-row">
      <text class="tip-dot"></text>
      <text>录音保存在微信本机临时目录，转换或剪辑完成后请及时保存。</text>
    </view>
    <view class="tip-row">
      <text class="tip-dot"></text>
      <text>页面切到后台会自动暂停录音；来电或语音通话中断后不会自动继续。</text>
    </view>
    <view class="tip-row">
      <text class="tip-dot"></text>
      <text>若提示隐私未配置，请在小程序后台「用户隐私保护指引」声明「访问你的麦克风」。</text>
    </view>
  </view>

</view>
