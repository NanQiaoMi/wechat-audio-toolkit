/* miniprogram/pages/record/record.wxss */
/* 现场录音页 · 暖纸风格（画布 #F8F6F2 / 白卡 #FFFFFF / 炭黑 #1C1917 / 灰 #78716C / 橙 #FF6B00） */

.page-record {
  min-height: 100vh;
  background-color: #F8F6F2;
  padding: 32rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ============================================================
   1. 顶部品牌区
============================================================ */
.page-header {
  display: flex;
  flex-direction: column;
  padding: 8rpx 4rpx 4rpx;
}

.brand-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background-color: #F0EDE6;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  align-self: flex-start;
  margin-bottom: 10rpx;
}

.brand-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #FF6B00;
}

.brand-tag-text {
  font-size: 18rpx;
  font-weight: 800;
  color: #78716C;
  letter-spacing: 1.5rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1C1917;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.brand-desc {
  font-size: 24rpx;
  color: #78716C;
  margin-top: 6rpx;
  font-weight: 500;
}

/* ============================================================
   2. 异常提示卡
============================================================ */
.error-card {
  background-color: #FFFFFF;
  border: 1px solid rgba(180, 83, 9, 0.22);
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.error-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.error-icon {
  font-size: 30rpx;
}

.error-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #1C1917;
}

.error-body {
  font-size: 22rpx;
  color: #78716C;
  line-height: 1.6;
}

.error-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 4rpx;
}

.error-btn {
  min-width: 150rpx;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background-color: #FAF9F6;
  border: 1px solid #E7E5E4;
  color: #1C1917;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  transition: all 0.16s ease;
}

.error-btn.solid {
  background-color: #1C1917;
  border-color: #1C1917;
  color: #FFFFFF;
}

/* ============================================================
   3. 主录音卡（通用白卡基底）
============================================================ */
.card-panel {
  background-color: #FFFFFF;
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 32rpx;
  padding: 40rpx 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(0, 0, 0, 0.035);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ---------- IDLE ---------- */
.idle-stage {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.record-orb {
  position: relative;
  width: 216rpx;
  height: 216rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #FF8A3C 0%, #FF6B00 62%, #F25C00 100%);
  box-shadow: 0 20rpx 48rpx rgba(255, 107, 0, 0.32);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s ease;
}

.record-orb-hover {
  transform: scale(0.96);
  box-shadow: 0 12rpx 30rpx rgba(255, 107, 0, 0.24);
}

.record-orb-ring {
  position: absolute;
  left: -20rpx;
  top: -20rpx;
  right: -20rpx;
  bottom: -20rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 107, 0, 0.35);
  animation: orbHalo 2.8s ease-out infinite;
}

@keyframes orbHalo {
  0% {
    transform: scale(0.92);
    opacity: 0.9;
  }
  70% {
    transform: scale(1.16);
    opacity: 0;
  }
  100% {
    transform: scale(1.16);
    opacity: 0;
  }
}

.orb-icon {
  font-size: 60rpx;
  line-height: 1.1;
}

.orb-label {
  font-size: 26rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

.idle-hint {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1917;
}

.idle-sub {
  font-size: 22rpx;
  color: #78716C;
}

.spec-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-top: 4rpx;
}

.spec-chip {
  font-size: 19rpx;
  font-weight: 700;
  color: #78716C;
  background-color: #F5F3EF;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  letter-spacing: 0.5rpx;
}

/* ---------- RECORDING / PAUSED ---------- */
.active-stage {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.stage-top-meta {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.status-pill.live {
  background-color: #FFF7ED;
  border: 1px solid rgba(255, 107, 0, 0.25);
  color: #EA580C;
}

.status-pill.paused {
  background-color: #F5F3EF;
  border: 1px solid #E7E5E4;
  color: #78716C;
}

.status-pill.done {
  background-color: #F0FDF4;
  border: 1px solid rgba(22, 163, 74, 0.24);
  color: #16A34A;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #A8A29E;
}

.status-pill.live .live-dot {
  background-color: #FF6B00;
  animation: dotBlink 1.1s ease-in-out infinite;
}

.status-pill.done .live-dot {
  background-color: #16A34A;
}

@keyframes dotBlink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.25;
  }
}

/* 实时分贝指示胶囊 */
.live-decibel-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background-color: #F5F3EF;
  border: 1px solid #E7E5E4;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #78716C;
  transition: all 0.15s ease;
}

.live-decibel-val {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
  font-weight: 800;
}

.live-decibel-pill.good {
  background-color: #F0FDF4;
  border-color: rgba(22, 163, 74, 0.3);
  color: #16A34A;
}

.live-decibel-pill.loud {
  background-color: #FFF7ED;
  border-color: rgba(255, 107, 0, 0.35);
  color: #EA580C;
}

.live-decibel-pill.peak {
  background-color: #FEF2F2;
  border-color: rgba(220, 38, 38, 0.35);
  color: #DC2626;
}

.paused-dur-badge {
  font-size: 22rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
  font-weight: 700;
  color: #78716C;
  background-color: #F5F3EF;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.timer-display {
  font-size: 104rpx;
  font-weight: 800;
  color: #1C1917;
  line-height: 1.05;
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
}

.timer-display.is-paused {
  color: #78716C;
}

/* 实时滚动物理声波谱线舞台 (28 柱真实振幅能量响应) */
.live-wave-stage {
  position: relative;
  width: 100%;
  height: 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  box-sizing: border-box;
}

.live-wave-spectrum {
  width: 100%;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.live-spectrum-bar {
  width: 8rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #FF9A4D 0%, #FF6B00 100%);
  min-height: 8rpx;
  transform-origin: center;
  transition: height 0.08s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.08s ease;
  box-shadow: 0 1rpx 4rpx rgba(255, 107, 0, 0.2);
}

.live-spectrum-bar.frozen {
  background: linear-gradient(180deg, #D6D3D1 0%, #A8A29E 100%);
  box-shadow: none;
}

.live-wave-baseline {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  top: 50%;
  height: 1px;
  background-color: rgba(0, 0, 0, 0.04);
  pointer-events: none;
}

/* 系统级中断告警卡 */
.interruption-alert-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background-color: #FFFBEB;
  border: 1px solid rgba(245, 158, 11, 0.3);
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
  box-sizing: border-box;
}

.interruption-alert-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.interruption-alert-body {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.interruption-alert-title {
  font-size: 22rpx;
  font-weight: 800;
  color: #B45309;
}

.interruption-alert-sub {
  font-size: 20rpx;
  color: #92400E;
  line-height: 1.35;
}

/* 随时中断回放试听卡 (Inline Audition Player) */
.paused-audition-card {
  width: 100%;
  background: #F8F6F2;
  border: 1px solid #E7E5E4;
  border-radius: 22rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.paused-audition-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.audition-header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.audition-icon {
  font-size: 26rpx;
}

.audition-title {
  font-size: 22rpx;
  font-weight: 800;
  color: #1C1917;
}

.audition-dur-pill {
  font-size: 20rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
  font-weight: 700;
  color: #FF6B00;
  background: #FFF7ED;
  border: 1px solid #FFEDD5;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.paused-player-body {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.paused-play-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background-color: #1C1917;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  transition: transform 0.15s ease;
}

.paused-play-btn.playing {
  background-color: #FF6B00;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 0, 0.35);
}

.paused-play-icon {
  font-size: 26rpx;
  color: #FFFFFF;
  margin-left: 2rpx;
}

.paused-slider-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.paused-slider {
  margin: 6rpx 0;
  width: 100%;
}

.paused-time-meta {
  display: flex;
  justify-content: space-between;
  font-size: 18rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, monospace;
  font-weight: 700;
  color: #78716C;
}

.paused-actions {
  margin-top: 6rpx;
}

.paused-discard-link {
  font-size: 22rpx;
  color: #A8A29E;
  padding: 8rpx 16rpx;
  transition: color 0.15s ease;
}

.paused-discard-link:active {
  color: #DC2626;
}

.active-hint {
  font-size: 22rpx;
  color: #78716C;
  text-align: center;
  line-height: 1.5;
}

.interrupted-hint {
  font-size: 22rpx;
  color: #B45309;
  background-color: #FFFBEB;
  border: 1px solid rgba(180, 83, 9, 0.18);
  border-radius: 14rpx;
  padding: 8rpx 18rpx;
  line-height: 1.5;
  text-align: center;
}

.control-row {
  width: 100%;
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.ctrl-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  transition: all 0.16s ease;
}

.ctrl-btn.ghost {
  background-color: #FFFFFF;
  border: 1px solid #E7E5E4;
  color: #1C1917;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.ctrl-btn.ghost.accent {
  background-color: #FFF7ED;
  border-color: rgba(255, 107, 0, 0.32);
  color: #EA580C;
}

.ctrl-btn.finish {
  background-color: #1C1917;
  color: #FFFFFF;
  box-shadow: 0 10rpx 26rpx rgba(28, 25, 23, 0.22);
}

.ctrl-icon {
  font-size: 28rpx;
}

/* ---------- REVIEW ---------- */
.review-stage {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.review-file {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: #FAF9F6;
  border: 1px solid #EFEDE8;
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
}

.file-emoji {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background-color: #FFF7ED;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.file-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.file-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1917;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-spec {
  font-size: 21rpx;
  color: #78716C;
  font-weight: 500;
}

.preview-player {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background-color: #FAF9F6;
  border: 1px solid #EFEDE8;
  border-radius: 24rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.player-toggle {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background-color: #1C1917;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(28, 25, 23, 0.18);
  transition: all 0.16s ease;
}

.player-toggle.playing {
  background-color: #FF6B00;
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 0, 0.3);
}

.player-slider-wrap {
  flex: 1;
  min-width: 0;
}

.player-slider {
  margin: 0;
}

.player-time-row {
  display: flex;
  justify-content: space-between;
  margin-top: 2rpx;
}

.player-time {
  font-size: 20rpx;
  font-weight: 600;
  color: #A8A29E;
  font-variant-numeric: tabular-nums;
}

.review-hint {
  font-size: 22rpx;
  color: #78716C;
  text-align: center;
  line-height: 1.5;
}

.action-col {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.primary-action {
  height: 100rpx;
  border-radius: 999rpx;
  background-color: #1C1917;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 28rpx rgba(28, 25, 23, 0.22);
  transition: all 0.16s ease;
}

.secondary-action {
  height: 96rpx;
  border-radius: 999rpx;
  background-color: #FFF7ED;
  border: 1px solid rgba(255, 107, 0, 0.32);
  color: #EA580C;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 800;
  transition: all 0.16s ease;
}

.ghost-action {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #78716C;
  transition: opacity 0.16s ease;
}

/* ============================================================
   4. 底部说明卡
============================================================ */
.tips-card {
  background-color: #FFFFFF;
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tips-title {
  font-size: 22rpx;
  font-weight: 800;
  color: #78716C;
  letter-spacing: 1rpx;
}

.tip-row {
  display: flex;
  gap: 12rpx;
  font-size: 22rpx;
  color: #78716C;
  line-height: 1.6;
}

.tip-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #FF6B00;
  margin-top: 14rpx;
  flex-shrink: 0;
}

/* ============================================================
   5. 通用按压反馈
============================================================ */
.btn-hover {
  transform: scale(0.97);
  opacity: 0.9;
}
