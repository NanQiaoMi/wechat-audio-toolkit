<!-- miniprogram/pages/video-extract/video-extract.wxml -->
<view class="container">
  
  <!-- 1. 顶部极简品牌条 -->
  <view class="page-topbar">
    <view class="topbar-title-group">
      <text class="topbar-main">🎬 视频提取音频</text>
      <text class="topbar-sub">支持相册短视频 / 微信聊天视频 · 毫秒级极速剥离</text>
    </view>
    <view class="topbar-actions">
      <view class="topbar-pill-btn" bindtap="goLibrary">
        <text class="topbar-pill-icon">📚</text>
        <text>我的作品</text>
      </view>
    </view>
  </view>

  <!-- 2. 空态/未选视频状态 (Hero Card) -->
  <view wx:if="{{status === 'idle'}}" class="card-panel hero-picker-card">
    <view class="picker-dropzone">
      <view class="picker-clapperboard-icon">
        <view class="clapperboard-top"></view>
        <view class="clapperboard-sparkle">🎬</view>
      </view>

      <text class="picker-main-title">选取视频，提取无损原声音频</text>
      <text class="picker-sub-title">优先调用本地硬件解封装，1秒提取，节省97%流量</text>

      <view class="picker-actions-column">
        <button class="primary-picker-btn" bindtap="chooseAlbumVideo" hover-class="picker-btn-hover">
          <text class="picker-btn-icon">📱</text>
          <text class="picker-btn-label">从手机相册选取视频</text>
        </button>
        <button class="secondary-picker-btn" bindtap="chooseMessageVideo" hover-class="picker-btn-hover">
          <text class="picker-btn-icon">💬</text>
          <text class="picker-btn-label">从微信聊天会话选取（推荐）</text>
        </button>
      </view>

      <view class="picker-tip-box">
        <text class="tip-icon">💡</text>
        <text class="tip-text">提示：部分手机相册视频（如高画质/杜比/多声道）受微信底层转码限制会提示“解码失败”，此时请将视频发至「文件传输助手」，点击上方「从微信聊天会话选取」，可 100% 避开相册压缩直接秒级提取！</text>
      </view>

      <view class="picker-spec-capsule">
        <text>支持 MP4 / MOV 格式 · 单个视频 ≤ 500MB · 最长建议 30 分钟</text>
      </view>
    </view>
  </view>

  <!-- 3. 正在提取状态 (Progress Card) -->
  <view wx:elif="{{status === 'extracting'}}" class="card-panel extracting-card">
    <view class="extract-anim-box">
      <view class="extract-pulse-ring ring-1"></view>
      <view class="extract-pulse-ring ring-2"></view>
      <view class="extract-center-icon">⚡</view>
    </view>

    <text class="extract-status-title">{{extractTitle}}</text>
    <text class="extract-status-sub">{{extractSubTip}}</text>

    <view class="source-video-preview-pill">
      <text class="src-vid-name">{{videoInfo.name}}</text>
      <text class="src-vid-meta">{{videoInfo.sizeText}} · {{videoInfo.durationText}}</text>
    </view>

    <view class="extract-mode-badge {{isCloudProcessing ? 'cloud' : 'local'}}">
      <text>{{isCloudProcessing ? '☁️ 云端高精度转码抽取中…' : '⚡ 本地芯片级容器解复用中…'}}</text>
    </view>
  </view>

  <!-- 4. 提取成功结果卡片 (Success Card) -->
  <view wx:elif="{{status === 'success'}}" class="card-panel result-card">
    
    <!-- 头部成功指示器 -->
    <view class="result-status-header">
      <view class="result-check-badge">✓</view>
      <view class="result-title-group">
        <text class="result-headline">音频提取成功</text>
        <text class="result-speed-tag">{{speedDescText || ('耗时 ' + (extractCostText || (extractCostMs + 'ms')) + ' · ' + (extractMode === 'local' ? '本地极速剥离 (0流量)' : '云端转码'))}}</text>
      </view>
      <view class="repick-btn" bindtap="resetToPicker" hover-class="btn-hover">
        <text class="repick-icon">🔄</text>
        <text>重选</text>
      </view>
    </view>

    <!-- 视频与提取音频元数据展示 -->
    <view class="extracted-meta-card">
      <image wx:if="{{videoInfo.thumbTempFilePath}}" class="video-thumb" src="{{videoInfo.thumbTempFilePath}}" mode="aspectFill"></image>
      <view wx:else class="video-thumb-placeholder">🎬</view>
      
      <view class="extracted-text-group">
        <text class="extracted-audio-name">{{resultAudio.title}}</text>
        <view class="extracted-tags-row">
          <text class="tag-capsule format">{{resultAudio.formatUpper}}</text>
          <text class="tag-capsule dur">{{resultAudio.durationText}}</text>
          <text class="tag-capsule size">{{resultAudio.sizeText}}</text>
          <text wx:if="{{extractMode === 'local'}}" class="tag-capsule cloud-convert-pill" bindtap="reExtractViaCloud" hover-class="tag-hover">☁️ 转为标准MP3</text>
        </view>
      </view>
    </view>

    <!-- 即时原声高保真试听器 (Audition Player) -->
    <view class="audition-player-panel">
      <view class="player-controls-row">
        <!-- 播放/暂停按键 -->
        <view class="player-toggle-btn {{isPlaying ? 'playing' : ''}}" bindtap="togglePlayAudio" hover-class="player-btn-hover">
          <text class="player-btn-glyph">{{isPlaying ? '⏸' : '▶'}}</text>
        </view>

        <!-- 寻位滑条与起止时间 -->
        <view class="player-seek-wrapper">
          <view class="player-time-row">
            <view class="player-time-left">
              <text class="player-time-current">{{playCurrentTimeText}}</text>
              <text wx:if="{{isPlaying}}" class="player-status-tag">● 正在试听</text>
            </view>
            <text class="player-time-total">{{resultAudio.durationText}}</text>
          </view>
          <slider
            class="player-slider"
            min="0"
            max="{{sliderMax}}"
            value="{{sliderValue}}"
            backgroundColor="#E7E5E4"
            activeColor="#FF6B00"
            block-size="14"
            block-color="#FF6B00"
            bindchanging="onSliderChanging"
            bindchange="onSliderChange"
          />
        </view>
      </view>
    </view>

    <!-- 核心操作按钮组 -->
    <view class="result-action-buttons">
      <!-- 英雄主行动：送入多轨剪辑 -->
      <button class="export-btn primary-editor" bindtap="sendToEditor" hover-class="btn-hover-scale">
        <text class="btn-icon-emoji">✂️</text>
        <view class="btn-text-col">
          <text class="btn-main-title">送入多轨剪辑</text>
          <text class="btn-sub-title">自由裁剪 · 多轨混音 · 智能变速</text>
        </view>
        <text class="btn-arrow-icon">➔</text>
      </button>

      <!-- 双列操作区：发好友 / 保存至手机 -->
      <view class="sub-export-row">
        <button class="export-btn primary-share" bindtap="shareOrSaveAudio" hover-class="btn-hover-scale">
          <text class="btn-icon-emoji">🚀</text>
          <text>发给微信好友</text>
        </button>
        <button class="export-btn secondary-save" bindtap="saveToLocalDisk" hover-class="btn-hover-scale">
          <text class="btn-icon-emoji">💾</text>
          <text>保存至手机</text>
        </button>
      </view>
    </view>

    <!-- 辅助工具：格式转换与压缩 -->
    <view class="converter-utility-card" bindtap="sendToConverter" hover-class="utility-hover">
      <view class="utility-left">
        <text class="utility-icon">⚡</text>
        <view class="utility-text-group">
          <text class="utility-title">转格式 / 压缩音频</text>
          <text class="utility-sub">转 MP3/WAV/FLAC 或一键极限压缩</text>
        </view>
      </view>
      <text class="utility-arrow">➔</text>
    </view>

    <!-- 底部辅助行：我的作品 + 重新提取 -->
    <view class="aux-links-row">
      <view class="aux-link-item library-link" bindtap="goLibrary">
        <text class="aux-link-icon">📚</text>
        <text>我的作品 (已自动入库)</text>
      </view>
      <view class="aux-link-item reset-btn" bindtap="resetToPicker">
        <text class="aux-link-icon">🔄</text>
        <text>换个视频</text>
      </view>
    </view>
  </view>

  <!-- 5. 错误提示卡片 (Error Card) -->
  <view wx:elif="{{status === 'error'}}" class="card-panel error-card">
    <view class="error-icon-box">⚠️</view>
    <text class="error-main-msg">音频提取遇到问题</text>
    <text class="error-detail-msg">{{errorMessage}}</text>
    <view class="error-actions-row">
      <button class="pill-btn primary" bindtap="resetToPicker">重新选择视频</button>
    </view>
  </view>

  <!-- 6. 底部技术说明 -->
  <view class="page-footer">
    <text class="footer-tip">💡 提示：短视频背景音乐、电影原声、语音讲解均可高保真秒级剥离</text>
  </view>
</view>
