/* miniprogram/pages/video-extract/video-extract.wxss */
/**
 * 视频提取音频专享页 · 暖纸极简美学
 * 基础底色：#F8F6F2 / 白卡：#FFFFFF / 炭黑：#1C1917 / 强调：#FF6B00 / 成功：#16A34A
 */

.container {
  min-height: 100vh;
  background-color: #F8F6F2;
  padding: 30rpx 28rpx calc(50rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ============================================================
   1. 顶部品牌条
============================================================ */
.page-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx;
}

.topbar-title-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.topbar-main {
  font-size: 38rpx;
  font-weight: 800;
  color: #1C1917;
  letter-spacing: -0.5rpx;
}

.topbar-sub {
  font-size: 21rpx;
  color: #78716C;
  font-weight: 500;
}

.topbar-actions {
  display: flex;
  align-items: center;
}

.topbar-pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background-color: #FFFFFF;
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 30rpx;
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #1C1917;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  transition: transform 0.16s ease;
}

.topbar-pill-btn:active {
  transform: scale(0.96);
  background-color: #FAF8F5;
}

.topbar-pill-icon {
  font-size: 24rpx;
}

/* ============================================================
   通用卡片面板
============================================================ */
.card-panel {
  background-color: #FFFFFF;
  border: 1px solid #EAE6DF;
  border-radius: 28rpx;
  padding: 36rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ============================================================
   2. 待选视频 Hero 卡片 (Dropzone)
============================================================ */
.hero-picker-card {
  padding: 50rpx 32rpx;
}

.picker-dropzone {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  width: 100%;
}

.picker-clapperboard-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #FFF7ED;
  border: 2rpx dashed #FF6B00;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  position: relative;
}

.clapperboard-sparkle {
  font-size: 56rpx;
  line-height: 1;
}

.picker-main-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1C1917;
  margin-bottom: 8rpx;
}

.picker-sub-title {
  font-size: 23rpx;
  color: #78716C;
  margin-bottom: 36rpx;
  line-height: 1.4;
}

.picker-actions-column {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  width: 100%;
  max-width: 580rpx;
}

.primary-picker-btn {
  background-color: #1C1917;
  color: #FFFFFF;
  border-radius: 44rpx;
  padding: 24rpx 36rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 6rpx 20rpx rgba(28, 25, 23, 0.15);
  border: none;
  line-height: 1.2;
}

.secondary-picker-btn {
  background-color: #FAF8F5;
  color: #1C1917;
  border: 1px solid #D6D1C7;
  border-radius: 44rpx;
  padding: 24rpx 36rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  line-height: 1.2;
}

.picker-btn-hover {
  transform: scale(0.98);
  opacity: 0.9;
}

.picker-btn-icon {
  font-size: 32rpx;
}

.picker-tip-box {
  margin-top: 24rpx;
  background-color: #FEF3C7;
  border: 1px solid #FDE68A;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  text-align: left;
  box-sizing: border-box;
  width: 100%;
}

.picker-tip-box .tip-icon {
  font-size: 26rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

.picker-tip-box .tip-text {
  font-size: 22rpx;
  color: #92400E;
  line-height: 1.5;
  font-weight: 500;
}

.picker-spec-capsule {
  margin-top: 32rpx;
  background-color: #F5F3EE;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  font-size: 20rpx;
  color: #78716C;
  font-weight: 500;
}

/* ============================================================
   3. 提取中动画与进度卡片
============================================================ */
.extracting-card {
  padding: 60rpx 32rpx;
}

.extract-anim-box {
  width: 130rpx;
  height: 130rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.extract-pulse-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 3rpx solid #FF6B00;
  opacity: 0.4;
  animation: pulseRing 1.6s ease-out infinite;
}

.extract-pulse-ring.ring-2 {
  animation-delay: 0.5s;
}

@keyframes pulseRing {
  0% {
    transform: scale(0.7);
    opacity: 0.8;
  }
  100% {
    transform: scale(1.4);
    opacity: 0;
  }
}

.extract-center-icon {
  font-size: 54rpx;
  animation: rotateGlow 2s linear infinite;
}

@keyframes rotateGlow {
  0% { transform: scale(1); }
  50% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

.extract-status-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1C1917;
  margin-bottom: 8rpx;
}

.extract-status-sub {
  font-size: 23rpx;
  color: #78716C;
  margin-bottom: 28rpx;
}

.source-video-preview-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  background-color: #F5F3EE;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  margin-bottom: 24rpx;
  max-width: 520rpx;
}

.src-vid-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #1C1917;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.src-vid-meta {
  font-size: 20rpx;
  color: #78716C;
}

.extract-mode-badge {
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.extract-mode-badge.local {
  background-color: #ECFDF5;
  color: #065F46;
  border: 1px solid #A7F3D0;
}

.extract-mode-badge.cloud {
  background-color: #FFF7ED;
  color: #C2410C;
  border: 1px solid #FED7AA;
}

/* ============================================================
   4. 提取成功结果卡片 (Fresh Master Victory Card，完全统一首页规范)
============================================================ */
.result-success-card {
  align-items: stretch;
  padding: 36rpx 28rpx;
  gap: 22rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  border: 1px solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  box-sizing: border-box;
  width: 100%;
}

/* 头部成功指示行 */
.result-top-badge {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 2rpx;
}

.result-title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.success-icon {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background-color: #16A34A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.success-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1C1917;
  letter-spacing: -0.3rpx;
}

.header-right-action {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cost-tag {
  font-size: 21rpx;
  font-weight: 700;
  color: #16A34A;
}

.repick-btn-pill {
  background-color: #FAF8F5;
  border: 1px solid #EAE6DF;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  color: #57534E;
  font-weight: 600;
  transition: all 0.15s ease;
}

.repick-btn-pill:active,
.pill-hover {
  background-color: #EAE6DF;
  transform: scale(0.95);
}

/* 体积对比看板 (Before & After Contrast Board) */
.size-comparison-board {
  background-color: #F8FAF8;
  border: 1px solid #DCFCE7;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-sizing: border-box;
  width: 100%;
}

.comp-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.comp-label {
  font-size: 20rpx;
  color: #78716C;
}

.comp-number {
  font-size: 32rpx;
  font-weight: 800;
  color: #1C1917;
  margin: 4rpx 0;
}

.comp-format-tag {
  font-size: 18rpx;
  font-weight: 700;
  background-color: #E7E5E4;
  color: #44403C;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.comp-format-tag.accent {
  background-color: #16A34A;
  color: #FFFFFF;
}

.comp-center-divider {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.comp-arrow-symbol {
  font-size: 32rpx;
  font-weight: 800;
  color: #16A34A;
}

.comp-saved-badge {
  font-size: 18rpx;
  font-weight: 800;
  background-color: #16A34A;
  color: #FFFFFF;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

/* 提取音频元数据标题行 */
.extracted-title-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background-color: #FAF8F5;
  border: 1px solid #EAE6DF;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  width: 100%;
}

.meta-icon-box {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  background-color: #F0EDE6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.meta-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.extracted-audio-name {
  font-size: 25rpx;
  font-weight: 700;
  color: #1C1917;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-badges-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.pill-badge {
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.pill-badge.codec-badge {
  background-color: #1C1917;
  color: #FFFFFF;
}

.pill-badge.time-badge {
  background-color: #EAE6DF;
  color: #44403C;
}

.pill-badge.size-badge {
  background-color: #F5F3EE;
  color: #78716C;
}

.pill-badge.cloud-convert-badge {
  background-color: #FEF3C7;
  color: #B45309;
  border: 1px solid #FCD34D;
  margin-left: 4rpx;
}

/* 原声高保真试听面板 (与首页一致) */
.result-audition-box {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
  box-sizing: border-box;
}

.audition-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.audition-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.audition-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #1C1917;
}

.audition-playing-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background-color: #DCFCE7;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.wave-dot-anim {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #16A34A;
  animation: primaryPlayPulse 1.2s infinite ease-in-out;
}

@keyframes primaryPlayPulse {
  0% { transform: scale(0.8); opacity: 0.7; }
  50% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(0.8); opacity: 0.7; }
}

.playing-txt {
  font-size: 19rpx;
  font-weight: 700;
  color: #15803D;
}

.prep-indicator.ready {
  font-size: 20rpx;
  color: #16A34A;
  font-weight: 600;
}

.result-inline-player {
  background-color: #F8FAF8;
  border: 1px solid #DCFCE7;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  width: 100%;
}

.player-play-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background-color: #1C1917;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(28, 25, 23, 0.2);
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.player-play-btn:active,
.play-btn-hover {
  transform: scale(0.92);
}

.player-play-btn.playing {
  background-color: #FF6B00;
  box-shadow: 0 4rpx 14rpx rgba(255, 107, 0, 0.3);
}

.play-btn-icon {
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}

.player-progress-area {
  flex: 1;
  min-width: 0;
}

.custom-slider {
  margin: 0;
  width: 100%;
}

.player-time-display {
  display: flex;
  justify-content: space-between;
  margin-top: 4rpx;
}

.time-item {
  font-size: 20rpx;
  color: #78716C;
  font-family: monospace;
}

.time-item.current {
  color: #FF6B00;
  font-weight: 700;
}

/* ============================================================
   操作导出按钮组体系 (彻底清除 184px 顽疾，完全对齐首页)
============================================================ */
.result-action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100% !important;
  box-sizing: border-box;
}

/* 关键：强制重置微信 button:not([size='mini']) 的 184px 默认宽度 */
.result-action-buttons button,
.export-btn {
  width: 100% !important;
  max-width: 100% !important;
  margin: 0 !important;
  border-radius: 999rpx !important;
  padding: 0 !important;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
  line-height: 1;
  box-sizing: border-box !important;
  transition: all 0.15s ease;
}

.export-btn:active,
.btn-hover-active {
  transform: scale(0.97);
  opacity: 0.92;
}

/* 核心英雄级主行动：送入多轨剪辑 (全宽 96rpx 暖橙胶囊) */
.export-btn.primary-editor {
  background-color: #FF6B00;
  color: #FFFFFF;
  height: 96rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 0, 0.28);
}

.btn-icon-emoji {
  font-size: 30rpx;
}

/* 双列次级操作区 (50/50 严格自适应对称，绝无右侧溢出) */
.sub-export-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100% !important;
  box-sizing: border-box;
}

.sub-export-row button,
.sub-export-row .export-btn {
  width: 100% !important;
  margin: 0 !important;
}

.export-btn.primary-share {
  background-color: #16A34A;
  color: #FFFFFF;
  height: 86rpx;
  box-shadow: 0 4rpx 16rpx rgba(22, 163, 74, 0.25);
  font-size: 26rpx;
}

.export-btn.secondary-save {
  background-color: #1C1917;
  color: #FFFFFF;
  height: 86rpx;
  box-shadow: 0 4rpx 16rpx rgba(28, 25, 23, 0.2);
  font-size: 26rpx;
}

/* 辅助工具：格式转换与压缩 (优雅胶囊卡片) */
.converter-utility-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #FAF8F5;
  border: 1px solid #EAE6DF;
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  width: 100%;
  box-sizing: border-box;
  transition: all 0.16s ease;
}

.utility-hover {
  background-color: #F5F3EE;
  transform: scale(0.98);
}

.utility-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.utility-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.utility-text-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.utility-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #1C1917;
}

.utility-sub {
  font-size: 20rpx;
  color: #78716C;
}

.utility-arrow {
  font-size: 22rpx;
  color: #A8A29E;
  flex-shrink: 0;
}

/* 底部辅助链接 (与首页完全统一) */
.aux-links-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 6rpx 0;
  border-top: 1px dashed #E7E5E4;
  width: 100%;
  box-sizing: border-box;
}

.aux-link-item {
  font-size: 22rpx;
  font-weight: 600;
  color: #1C1917;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 2rpx;
  transition: opacity 0.15s ease;
}

.aux-link-item:active {
  opacity: 0.65;
}

.aux-link-icon {
  font-size: 24rpx;
}

.aux-link-item.library-link {
  color: #B45309;
}

.aux-link-item.reset-btn {
  color: #78716C;
}

/* ============================================================
   5. 错误提示卡片
============================================================ */
.error-card {
  padding: 50rpx 32rpx;
  text-align: center;
}

.error-icon-box {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.error-main-msg {
  font-size: 30rpx;
  font-weight: 800;
  color: #B91C1C;
  margin-bottom: 8rpx;
}

.error-detail-msg {
  font-size: 22rpx;
  color: #78716C;
  margin-bottom: 30rpx;
  line-height: 1.4;
  max-width: 500rpx;
}

.error-actions-row {
  display: flex;
  justify-content: center;
}

.pill-btn.primary {
  background-color: #1C1917;
  color: #FFFFFF;
  border-radius: 40rpx;
  padding: 16rpx 36rpx;
  font-size: 26rpx;
  font-weight: 700;
  border: none;
}

/* ============================================================
   6. 底部说明
============================================================ */
.page-footer {
  text-align: center;
  padding: 12rpx 16rpx;
}

.footer-tip {
  font-size: 20rpx;
  color: #A8A29E;
  line-height: 1.5;
}
