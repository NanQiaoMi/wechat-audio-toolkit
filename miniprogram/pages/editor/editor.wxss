/* miniprogram/pages/editor/editor.wxss */
/* Clean, Modern Editorial Design for Audio Splicer & Trimmer Studio */
/* Reference: Refero Design - Superr (Warm Paper #F8F6F2, Charcoal #1C1917, Marker Orange #FF6B00) */

.app-container {
  background-color: #F8F6F2;
  min-height: 100vh;
  padding: 32rpx 28rpx 80rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
  color: #1C1917;
}

.app-container.with-export-bar {
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom)) !important;
}

/* ============================================================
   通用按键去除小程序默认伪类 (Button Normalize)
============================================================ */
button {
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  line-height: normal;
}

button::after {
  display: none;
}

/* ============================================================
   0. 现代物理弹簧曲线与动感动效库 (Dynamic Physics Animation Engine)
============================================================ */

/* 1. 弹簧弹出 (Overshoot Spring Pop) */
@keyframes springPopIn {
  0% { transform: scale(0.85); opacity: 0; }
  65% { transform: scale(1.05); opacity: 1; }
  85% { transform: scale(0.98); }
  100% { transform: scale(1); opacity: 1; }
}

/* 2. 抽屉/模态弹簧滑升 (Spring Slide Up) */
@keyframes drawerSpringUp {
  0% { transform: translateY(100%); }
  65% { transform: translateY(-12rpx); }
  85% { transform: translateY(4rpx); }
  100% { transform: translateY(0); }
}

/* 3. 背景毛玻璃渐显 (Smooth Backdrop Blur) */
@keyframes drawerFadeIn {
  0% { opacity: 0; backdrop-filter: blur(0px); -webkit-backdrop-filter: blur(0px); }
  100% { opacity: 1; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
}

/* 4. 浮动指示药丸弹性弹出与轻柔悬浮 (Floating Pill Spring Pop & Hover Bob) */
@keyframes springPillPop {
  0% { transform: translate(-50%, -14rpx) scale(0.8); opacity: 0; }
  65% { transform: translate(-50%, 2rpx) scale(1.06); opacity: 1; }
  100% { transform: translate(-50%, 0) scale(1); opacity: 1; }
}

@keyframes pillHoverBob {
  0% { transform: translate(-50%, 0); }
  50% { transform: translate(-50%, -4rpx); }
  100% { transform: translate(-50%, 0); }
}

/* 5. 播放状态激光光标呼吸律动 (Playhead Laser Pulse) */
@keyframes playheadLaserPulse {
  0% { filter: drop-shadow(0 2rpx 4rpx rgba(255, 59, 48, 0.6)); transform: translateX(-50%) scale(1); }
  50% { filter: drop-shadow(0 0 10rpx rgba(255, 59, 48, 1)); transform: translateX(-50%) scale(1.18); }
  100% { filter: drop-shadow(0 2rpx 4rpx rgba(255, 59, 48, 0.6)); transform: translateX(-50%) scale(1); }
}

@keyframes playheadBeamGlow {
  0% { box-shadow: 0 0 6rpx rgba(255, 59, 48, 0.5); }
  50% { box-shadow: 0 0 16rpx rgba(255, 59, 48, 0.95); }
  100% { box-shadow: 0 0 6rpx rgba(255, 59, 48, 0.5); }
}

/* 6. 音频播放中波形柱跳动 (Audio Wave Rhythm Dance) */
@keyframes waveRhythmDanceA {
  0% { transform: scaleY(0.7); }
  50% { transform: scaleY(1.25); }
  100% { transform: scaleY(0.8); }
}

@keyframes waveRhythmDanceB {
  0% { transform: scaleY(1.2); }
  50% { transform: scaleY(0.6); }
  100% { transform: scaleY(1.15); }
}

@keyframes waveRhythmDanceC {
  0% { transform: scaleY(0.8); }
  50% { transform: scaleY(1.35); }
  100% { transform: scaleY(0.75); }
}

/* 7. 金色选中发光边律动 (Gold Glow Energy Flow) */
@keyframes goldGlowFlow {
  0% { background-position: 0% 50%; opacity: 0.85; }
  50% { background-position: 100% 50%; opacity: 1; filter: drop-shadow(0 0 6rpx #FF6B00); }
  100% { background-position: 0% 50%; opacity: 0.85; }
}

/* 8. 选中卡片微弹就位 (Card Select Pop) */
@keyframes cardSelectPop {
  0% { transform: scale(0.98); }
  60% { transform: scale(1.02); }
  100% { transform: scale(1); }
}

/* 9. 修剪把手活跃能量光晕 (Trim Handle Energy Glow) */
@keyframes handlePulseGlow {
  0% { box-shadow: 0 0 8rpx rgba(255, 107, 0, 0.6); filter: brightness(1); }
  50% { box-shadow: 0 0 20rpx rgba(255, 107, 0, 0.95), 0 0 0 4rpx rgba(255, 107, 0, 0.3); filter: brightness(1.15); }
  100% { box-shadow: 0 0 8rpx rgba(255, 107, 0, 0.6); filter: brightness(1); }
}

/* 10. 播放按钮呼吸光环 (Primary Play Pulse) */
@keyframes primaryPlayPulse {
  0% { box-shadow: 0 4rpx 16rpx rgba(28, 25, 23, 0.2), 0 0 0 0 rgba(255, 107, 0, 0.45); }
  50% { box-shadow: 0 6rpx 24rpx rgba(28, 25, 23, 0.3), 0 0 0 8rpx rgba(255, 107, 0, 0); }
  100% { box-shadow: 0 4rpx 16rpx rgba(28, 25, 23, 0.2), 0 0 0 0 rgba(255, 107, 0, 0.45); }
}

/* 11. 试听中药丸声波呼吸 (Aux Pill Pulse) */
@keyframes auxPillPulse {
  0% { box-shadow: 0 0 0 0 rgba(255, 107, 0, 0.4); transform: scale(1); }
  50% { box-shadow: 0 0 0 8rpx rgba(255, 107, 0, 0); transform: scale(1.02); }
  100% { box-shadow: 0 0 0 0 rgba(255, 107, 0, 0.4); transform: scale(1); }
}

/* 12. 黑胶唱片轻缓自转 (Vinyl Idle Rotation) */
@keyframes vinylIdleSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 13. 轨道静音/避让状态切换弹性脉冲 */
@keyframes pulseMute {
  0% { transform: scale(0.92); }
  60% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

@keyframes pulseDuck {
  0% { transform: scale(0.92); }
  60% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

/* ============================================================
   1. 顶部品牌区 (Header Nav)
============================================================ */
.header-nav {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 8rpx 4rpx 12rpx;
}

.brand-block {
  display: flex;
  flex-direction: column;
}

.brand-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background-color: #F0EDE6;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  align-self: flex-start;
  margin-bottom: 10rpx;
}

.brand-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #FF6B00;
}

.brand-tag-text {
  font-size: 18rpx;
  font-weight: 800;
  color: #78716C;
  letter-spacing: 1.5rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1C1917;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.brand-desc {
  font-size: 24rpx;
  color: #78716C;
  margin-top: 6rpx;
  font-weight: 500;
}

/* ============================================================
   通用卡片基底 (Card Panel - Clean Modern Editorial)
============================================================ */
.card-panel {
  background-color: #FFFFFF;
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 22rpx;
}

.panel-title-group {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1C1917;
}

.panel-subtitle {
  font-size: 22rpx;
  color: #A8A29E;
}

.panel-tip {
  font-size: 22rpx;
  color: #78716C;
}

/* ============================================================
   2. 空态：选文件面板 (Empty Dropzone) - 彻底解决添加文字折行与排版
============================================================ */
.empty-dropzone-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 48rpx 28rpx 40rpx;
  border: 2rpx dashed #D6D3D1;
  background-color: #FAF9F6;
  border-radius: 28rpx;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.empty-dropzone-panel:active {
  background-color: #F5F3EE;
  border-color: #FF6B00;
}

.upload-disc-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #292524 30%, #44403C 50%, #1C1917 75%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.14);
  margin-bottom: 28rpx;
  position: relative;
  animation: vinylIdleSpin 16s linear infinite;
}

.disc-groove {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.disc-hole {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background-color: #FF6B00;
}

.disc-sparkle {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  font-size: 30rpx;
}

.upload-main-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1C1917;
  letter-spacing: -0.3rpx;
  margin-bottom: 8rpx;
}

.upload-sub-title {
  font-size: 24rpx;
  color: #78716C;
  margin-bottom: 32rpx;
  line-height: 1.4;
}

/* 单行不换行的高质感药丸按键包裹容器 */
.action-btn-wrapper {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  margin-bottom: 20rpx;
}

button.primary-action-pill {
  background: linear-gradient(135deg, #2A2624 0%, #141210 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  padding: 24rpx 56rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  white-space: nowrap;
  box-shadow: 0 8rpx 24rpx rgba(28, 25, 23, 0.22), 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.12);
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease;
}

button.primary-action-pill:active {
  transform: scale(0.92) translateY(2rpx);
  box-shadow: 0 3rpx 10rpx rgba(28, 25, 23, 0.35);
  opacity: 0.95;
}

/* 「视频提取」与「现场录音」次级入口药丸 */
button.video-extract-entry-pill,
button.record-entry-pill {
  background: #FFFFFF;
  color: #1C1917;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 32rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  white-space: nowrap;
  border: 1px solid rgba(28, 25, 23, 0.12);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
}

button.video-extract-entry-pill:active,
button.record-entry-pill:active {
  transform: scale(0.94) translateY(2rpx);
  background: #FAF8F5;
}

.video-extract-entry-icon,
.record-entry-icon {
  font-size: 30rpx;
}

.video-extract-entry-text,
.record-entry-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #1C1917;
}

.action-pill-plus {
  font-size: 34rpx;
  font-weight: 800;
  color: #FF6B00;
  line-height: 1;
}

.action-pill-text {
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
}

/* 规格说明气泡标签 */
.spec-capsule-tag {
  background-color: #F0EDE6;
  border: 1px solid #E5E1D8;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  color: #78716C;
  font-weight: 600;
  letter-spacing: 0.2rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

/* 支持格式小标签 */
.support-format-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1px solid rgba(0, 0, 0, 0.06);
  width: 100%;
}

.format-mini-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #57534E;
  background-color: #ECE8E1;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
