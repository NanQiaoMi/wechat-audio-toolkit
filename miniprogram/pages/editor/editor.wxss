  gap: 20rpx;
  background-color: #FFFFFF;
}

.inspector-header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border-bottom: 1px solid #E7E5E4;
  padding-bottom: 16rpx;
}

.inspector-title-group {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.inspector-title-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.inspector-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1C1917;
}

.inspector-toggle-tag {
  font-size: 20rpx;
  font-weight: 700;
