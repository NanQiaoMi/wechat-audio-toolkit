}

.volume-val-badge {
  font-size: 22rpx;
  font-weight: 800;
  color: #FF6B00;
  background-color: #FFF7ED;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.volume-slider {
  margin: 10rpx 0 0;
}

.volume-footer-hint {
  font-size: 20rpx;
  color: #A8A29E;
  margin-top: 6rpx;
}

/* ============================================================
   7. 悬浮吸底导出与压缩控制栏 (Floating Bottom Export & Compression Dock)
============================================================ */
.floating-export-dock-wrapper {
  position: relative;
  z-index: 100;
}

/* 压缩后文件大小与控制面板 (悬浮抽屉卡片) */
.dock-compression-panel {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(154rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border: 1px solid #E7E5E4;
  border-radius: 32rpx;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.14);
  padding: 24rpx 28rpx;
  z-index: 101;
  animation: drawerSpringUp 0.34s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.compress-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #F5F3EE;
  padding-bottom: 12rpx;
}

.compress-panel-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.compress-title-mono-icon {
  width: 28rpx;
  height: 28rpx;
}

.compress-panel-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #1C1917;
}

.compress-close-pill {
  font-size: 20rpx;
  font-weight: 700;
  color: #78716C;
  background: #F5F3EE;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.compress-close-pill:active {
  transform: scale(0.9);
}

/* 实时体积与缩减看板 */
.compress-metrics-banner {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #FAF8F5;
  border: 1px solid #E7E5E4;
  border-radius: 18rpx;
  padding: 16rpx 14rpx;
}

.compress-metric-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.metric-label {
  font-size: 18rpx;
  color: #78716C;
}

.metric-value-huge {
  font-size: 30rpx;
  font-weight: 900;
  color: #1C1917;
}

.metric-value-huge.savings {
  color: #16A34A;
}

.metric-value-sub {
  font-size: 22rpx;
  font-weight: 800;
  color: #FF6B00;
}

.compress-metric-divider {
  width: 1px;
  height: 36rpx;
  background: #E7E5E4;
}

/* 滑块控制区 */
.compress-slider-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.slider-extremes-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.slider-extreme-hint {
  font-size: 18rpx;
  color: #A8A29E;
}

.slider-center-spec {
  font-size: 20rpx;
  font-weight: 800;
  color: #FF6B00;
  background: #FFF7ED;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  border: 1px solid #FFEDD5;
}

.compress-native-slider {
  margin: 10rpx 0 8rpx;
}

.bitrate-preset-row {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8rpx;
}

.bitrate-preset-chip {
  background: #FAF8F5;
  border: 1px solid #E7E5E4;
  border-radius: 12rpx;
  padding: 10rpx 2rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.18s ease;
}

.bitrate-preset-chip:active {
  transform: scale(0.92);
}

.bitrate-preset-chip.active {
  background: #1C1917;
  border-color: #1C1917;
  color: #FFFFFF;
  box-shadow: 0 4rpx 10rpx rgba(28, 25, 23, 0.2);
}

.preset-chip-rate {
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}

.bitrate-preset-chip.active .preset-chip-rate {
  color: #FFFFFF;
}

.preset-chip-tag {
  font-size: 16rpx;
  color: #78716C;
  line-height: 1;
}

.bitrate-preset-chip.active .preset-chip-tag {
  color: #D6D3D1;
}

.compress-panel-footer {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-top: 4rpx;
}

.compress-hint-badge {
  font-size: 18rpx;
  font-weight: 800;
  color: #EA580C;
  background: #FFF7ED;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.compress-hint-text {
  font-size: 18rpx;
  color: #78716C;
  line-height: 1.3;
}

/* ============================================================
   7. 悬浮吸底导出与压缩控制栏 (Floating Bottom Export & Compression Dock)
============================================================ */

/* 悬浮晶莹浮岛 (Floating Island Dock) */
.floating-export-dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1.5rpx solid rgba(231, 229, 228, 0.95);
  border-radius: 44rpx;
  padding: 14rpx 20rpx 14rpx 24rpx;
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  z-index: 100;
  box-shadow: 0 12rpx 36rpx rgba(28, 25, 23, 0.12), 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  animation: springPopIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 左侧信息列 */
.dock-meta-col {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1 1 auto;
  min-width: 0;
  padding-right: 12rpx;
}

.dock-meta-col:active {
  opacity: 0.82;
}

/* 上行：成片总时长与片段数 */
.dock-headline-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  line-height: 1.15;
}

.dock-duration-val {
  font-size: 32rpx;
  font-weight: 900;
  color: #1C1917;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
  flex-shrink: 0;
}

.dock-meta-dot {
  font-size: 18rpx;
  color: #D6D3D1;
  flex-shrink: 0;
}

.dock-clips-meta {
  font-size: 21rpx;
  font-weight: 600;
  color: #78716C;
  white-space: nowrap;
  flex-shrink: 0;
}

.dock-duration-val.ceiling-exceeded {
  color: #EF4444 !important;
}

.dock-ceiling-tag {
  font-size: 18rpx;
  font-weight: 800;
  background: #FEE2E2;
  color: #EF4444;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 4rpx;
}

/* 下行：一体化压缩规格交互胶囊 */
.dock-spec-capsule {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #FAF8F5;
  border: 1.5rpx solid #E7E5E4;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  align-self: flex-start;
  max-width: 100%;
  box-sizing: border-box;
  transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.dock-spec-capsule.active {
  background: #FFF7ED;
  border-color: #FF6B00;
  box-shadow: 0 2rpx 10rpx rgba(255, 107, 0, 0.18);
}

.dock-capsule-icon {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

.dock-spec-bitrate {
  font-size: 20rpx;
  font-weight: 800;
  color: #EA580C;
  flex-shrink: 0;
}

.dock-capsule-sep {
  font-size: 18rpx;
  color: #D6D3D1;
  flex-shrink: 0;
}

.dock-spec-size {
  font-size: 20rpx;
  font-weight: 700;
  color: #44403C;
  white-space: nowrap;
  flex-shrink: 0;
}

.dock-spec-savings {
  font-size: 18rpx;
  font-weight: 800;
  color: #16A34A;
  background: #DCFCE7;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.dock-capsule-arrow {
  font-size: 18rpx;
  color: #A8A29E;
  margin-left: 2rpx;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  flex-shrink: 0;
}

.dock-capsule-arrow.open {
  transform: rotate(180deg);
  color: #FF6B00;
}

.dock-error-row {
  display: flex;
  align-items: center;
}

.dock-error-text {
  font-size: 20rpx;
  color: #EF4444;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧：主导出按键 (强制重置小程序原生 button:not([size='mini']) 的默认尺寸与外边距，杜绝溢出重叠) */
button.dock-export-action-btn {
  flex: 0 0 auto !important;
  width: auto !important;
  max-width: 52% !important;
  min-width: 190rpx !important;
  height: 74rpx !important;
  line-height: 74rpx !important;
  margin: 0 !important;
  padding: 0 28rpx !important;
  box-sizing: border-box !important;
  white-space: nowrap !important;
  background: #1C1917 !important;
  color: #FFFFFF !important;
  border-radius: 999rpx !important;
  font-size: 26rpx !important;
  font-weight: 800 !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8rpx !important;
  box-shadow: 0 6rpx 20rpx rgba(28, 25, 23, 0.22) !important;
  transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.24s ease, background-color 0.2s ease;
}

button.dock-export-action-btn:active:not(.disabled) {
  transform: scale(0.92) translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(28, 25, 23, 0.12);
}

button.dock-export-action-btn.disabled {
  background: #E7E5E4;
  color: #A8A29E;
  box-shadow: none;
  pointer-events: none;
}

.export-btn-sparkle {
  font-size: 26rpx;
  line-height: 1;
}

.export-btn-label {
  line-height: 1;
}

/* ============================================================
   8. 导出中状态 (Exporting Progress Card)
============================================================ */
.exporting-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 40rpx 30rpx;
}

.exporting-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.exporting-texts {
  display: flex;
  flex-direction: column;
}

.exporting-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1C1917;
}

.exporting-sub {
  font-size: 24rpx;
  color: #FF6B00;
  font-weight: 700;
  margin-top: 4rpx;
}

.exporting-detail-box {
  background-color: #FAF9F6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-step {
  font-size: 22rpx;
  color: #78716C;
  line-height: 1.4;
}

.detail-hint {
  font-size: 20rpx;
  color: #A8A29E;
}

/* ============================================================
   9. 导出结果卡片 (Export Victory Card)
============================================================ */
.result-victory-card {
  border: 1.5px solid #BBF7D0;
  background-color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(22, 163, 74, 0.08);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  animation: springPopIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

.result-top-badge {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.result-title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.success-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #16A34A;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #15803D;
}

.cost-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #78716C;
}

.result-name-banner {
  background-color: #FAF9F6;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
}

.result-file-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1917;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

.result-spec-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.spec-cell {
  background-color: #F8FAF8;
  border: 1px solid #DCFCE7;
  border-radius: 16rpx;
  padding: 16rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.spec-label {
  font-size: 20rpx;
  color: #78716C;
}

.spec-value {
  font-size: 26rpx;
  font-weight: 800;
  color: #15803D;
  margin-top: 4rpx;
}

/* 试听播放器 */
.result-audition-card {
  background-color: #FAF9F6;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.audition-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.audition-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1917;
}

.audition-dur-label {
  font-size: 22rpx;
  color: #78716C;
  font-weight: 600;
}

.audition-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.audition-playing-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background-color: #DCFCE7;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.playing-txt {
  font-size: 20rpx;
  font-weight: 700;
  color: #15803D;
}

.audition-inline-player {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background-color: #FFFFFF;
  border: 1px solid #DCFCE7;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}

.audition-player-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.audition-progress-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.audition-progress-area slider {
  margin: 0;
}

.audition-time-row {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #78716C;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  padding: 0 4rpx;
}

.audition-play-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background-color: #1C1917;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(28, 25, 23, 0.2);
  flex-shrink: 0;
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease;
}

.audition-play-btn:active {
  transform: scale(0.88);
}

.audition-play-btn.playing {
  background-color: #16A34A;
  animation: primaryPlayPulse 1.6s infinite ease-in-out;
}

.audition-status-info {
  flex: 1;
}

.status-ready-tag {
  font-size: 22rpx;
  color: #15803D;
  font-weight: 600;
}

.status-loading-tag {
  font-size: 22rpx;
  color: #A8A29E;
}

.result-actions-grid {
  display: flex;
}

button.primary-share-btn {
  flex: 1;
  background-color: #16A34A;
  color: #FFFFFF;
  border-radius: 999rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(22, 163, 74, 0.25);
  transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
}

button.primary-share-btn:active {
  transform: scale(0.93) translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(22, 163, 74, 0.15);
}

.btn-icon {
  font-size: 28rpx;
}

.result-sub-actions {
  display: flex;
  justify-content: space-between;
  padding: 4rpx 6rpx;
}

.aux-link {
  font-size: 22rpx;
  font-weight: 600;
  color: #1C1917;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.aux-link.reset {
  color: #78716C;
}

.result-expiry-tip {
  font-size: 20rpx;
  color: #A8A29E;
  text-align: center;
  line-height: 1.4;
}

.footer-privacy-text {
  text-align: center;
  font-size: 20rpx;
  color: #A8A29E;
}

/* ============================================================
   10. 隐私授权弹窗 (Privacy Modal)
============================================================ */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  z-index: 999;
  animation: drawerFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.privacy-dialog-card {
  background-color: #FFFFFF;
  border-radius: 36rpx;
  margin: 0 40rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  animation: springPopIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

.privacy-dialog-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.privacy-dialog-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1C1917;
  margin-bottom: 14rpx;
}

.privacy-dialog-content {
  font-size: 24rpx;
  color: #78716C;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.privacy-dialog-link {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF6B00;
  text-decoration: underline;
  margin-bottom: 32rpx;
}

.privacy-dialog-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

button.dialog-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
}

button.dialog-btn:active {
  transform: scale(0.92);
}

button.dialog-btn.disagree {
  background-color: #F5F5F4;
  color: #78716C;
}

button.dialog-btn.agree {
  background-color: #1C1917;
  color: #FFFFFF;
}

/* ============================================================
   声音效果器抽屉 (Audio Inspector Bottom Sheet Drawer)
============================================================ */
.drawer-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 200;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: drawerFadeIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.drawer-sheet-card {
  background-color: #FFFFFF;
  border-top: 1px solid #E7E5E4;
  border-radius: 36rpx 36rpx 0 0;
  padding: 16rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.12);
  max-height: 82vh;
  overflow-y: auto;
  box-sizing: border-box;
  animation: drawerSpringUp 0.38s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

.drawer-grab-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background-color: #D6D3D1;
  margin: 12rpx auto 20rpx;
}

.drawer-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  border-bottom: 1px solid #E7E5E4;
  padding-bottom: 16rpx;
}

.drawer-title-group {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1C1917;
}

.drawer-subtitle {
  font-size: 22rpx;
  color: #78716C;
}

.drawer-close-btn {
  font-size: 26rpx;
  font-weight: 700;
  color: #FF6B00;
  background: #FFF7ED;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.15s ease;
}

.drawer-close-btn:active {
  transform: scale(0.92);
  background: #FFEDD5;
}

.drawer-tabs-scroll {
  width: 100%;
  white-space: nowrap;
  overflow-x: auto;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  -webkit-overflow-scrolling: touch;
}

.drawer-tabs-scroll .inspector-tab-bar {
  display: inline-flex;
  min-width: 100%;
  gap: 10rpx;
  box-sizing: border-box;
}

.drawer-tabs-scroll .inspector-tab-bar .tab-chip {
  flex: 0 0 auto !important;
  white-space: nowrap !important;
  padding: 12rpx 24rpx !important;
  font-size: 24rpx !important;
}

.drawer-scroll-body {
  max-height: 60vh;
  box-sizing: border-box;
}

.section-hint-text {
  font-size: 20rpx;
  color: #78716C;
  line-height: 1.4;
  margin-top: 6rpx;
}
