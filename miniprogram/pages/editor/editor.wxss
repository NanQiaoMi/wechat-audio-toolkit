  background: #FAF8F5;
  border-radius: 16rpx;
  padding: 16rpx;
  border: 1px solid #E7E5E4;
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.18s ease;
}

.inspector-compact-summary:active {
  background: #F5F3EE;
  transform: scale(0.98);
}

.compact-params-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.compact-param-chip {
  background: #FFFFFF;
  border: 1px solid #E7E5E4;
  border-radius: 12rpx;
  padding: 10rpx 6rpx;
