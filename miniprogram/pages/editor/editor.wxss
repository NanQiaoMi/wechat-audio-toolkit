  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  text-align: center;
}

.compact-label {
  font-size: 18rpx;
  color: #78716C;
}

.compact-val {
  font-size: 22rpx;
  font-weight: 800;
  color: #1C1917;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

.compact-expand-pill {
  font-size: 20rpx;
  font-weight: 700;
  color: #FF6B00;
  text-align: center;
  margin-top: 2rpx;
}

.inspector-target {
  font-size: 22rpx;
  color: #78716C;
  font-weight: 600;
}

.inspector-tab-bar {
  display: flex;
  background-color: #F5F3EE;
  border: 1px solid #E7E5E4;
  padding: 6rpx;
  border-radius: 16rpx;
  gap: 6rpx;
}

.tab-chip {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #78716C;
  border-radius: 12rpx;
  transition: transform 0.24s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.18s ease, background-color 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
}

.tab-chip:active {
  transform: scale(0.92);
}

.tab-chip.active {
  background-color: #FFFFFF;
  color: #1C1917;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transform: scale(1.02);
}

.inspector-content-box {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.tool-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-label-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1C1917;
}

.section-val {
  font-size: 22rpx;
  font-weight: 700;
  color: #78716C;
}

.section-val.highlight {
  color: #FF6B00;
  font-size: 24rpx;
  font-weight: 800;
}

.chips-selector-row {
  display: flex;
  gap: 10rpx;
  width: 100%;
  box-sizing: border-box;
}

.chips-selector-row.wrap {
  flex-wrap: wrap;
}

/* 速度选择网格：3列 x 2行 对称排版，防出界，大触控区 */
.chips-selector-row.speed-grid {
  display: grid !important;
  grid-template-columns: repeat(3, 1fr) !important;
  gap: 12rpx !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.chips-selector-row.speed-grid .sel-chip {
  flex: none !important;
  width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
  padding: 16rpx 6rpx !important;
  font-size: 24rpx !important;
}

/* 声音均衡器网格：4列 x 2行 对称排版，8种经典预设，视觉秩序绝对规整 */
.chips-selector-row.eq-grid,
.chips-selector-row.wrap.eq-grid {
  display: grid !important;
  grid-template-columns: repeat(4, 1fr) !important;
  gap: 10rpx !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.chips-selector-row.eq-grid .sel-chip,
.chips-selector-row.wrap.eq-grid .sel-chip {
  flex: none !important;
  width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
  padding: 14rpx 4rpx !important;
  font-size: 21rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 4rpx !important;
  white-space: nowrap !important;
}

/* 降噪梯度网格：4列严格均分 */
.chips-selector-row.denoise-grid {
  display: grid !important;
  grid-template-columns: repeat(4, 1fr) !important;
  gap: 10rpx !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.chips-selector-row.denoise-grid .sel-chip {
  flex: none !important;
  width: 100% !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
  padding: 16rpx 4rpx !important;
  font-size: 21rpx !important;
  white-space: nowrap !important;
}

/* 快捷音量增益预设胶囊排 (4列等宽，单点即达) */
.gain-presets-row {
  display: grid !important;
  grid-template-columns: repeat(4, 1fr) !important;
  gap: 10rpx !important;
  width: 100% !important;
  margin-bottom: 12rpx !important;
  box-sizing: border-box !important;
}

.gain-preset-pill {
  background-color: #FAF8F5;
  border: 1px solid #E7E5E4;
  border-radius: 999rpx;
  padding: 10rpx 4rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #78716C;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.18s ease;
}

.gain-preset-pill:active {
  transform: scale(0.92);
}

.gain-preset-pill.active {
  background-color: #FFF7ED;
  border-color: #FF6B00;
  color: #FF6B00;
  font-weight: 800;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 0, 0.15);
}

.sel-chip {
  flex: 1;
  min-width: 120rpx;
  background-color: #FAF8F5;
  border: 1px solid #E7E5E4;
  border-radius: 16rpx;
  padding: 14rpx 8rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #78716C;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
