}

.sel-chip:active {
  transform: scale(0.90) translateY(2rpx);
}

.sel-chip.active {
  background-color: #FFF7ED;
  border-color: #FF6B00;
  color: #FF6B00;
  box-shadow: 0 2rpx 10rpx rgba(255, 107, 0, 0.18);
  transform: scale(1.03);
