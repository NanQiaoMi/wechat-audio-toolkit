}

.classic-mono-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
}

.fast-mono-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
}

.transport-mono-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
}

.aux-mono-icon {
  width: 26rpx;
  height: 26rpx;
  display: block;
}

/* 专业级剪辑功能动作缎带 (CapCut / NLE 风格横向滚动工具栏) */
.pro-tools-ribbon-wrapper {
