}

/* 错误与异常提醒 */
.error-card {
  border: 1px solid #FECACA;
  background-color: #FEF2F2;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.error-top-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.error-icon {
  font-size: 32rpx;
}

.error-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #991B1B;
}

.error-text {
  font-size: 24rpx;
  color: #B91C1C;
  line-height: 1.4;
}

.error-file-names {
  font-size: 22rpx;
  color: #7F1D1D;
  font-weight: 600;
}

.error-actions-row {
  display: flex;
  gap: 14rpx;
  margin-top: 6rpx;
}

.pill-btn {
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.pill-btn.ghost {
  background-color: #FFFFFF;
  border: 1px solid #E7E5E4;
  color: #1C1917;
}

.pill-btn.primary {
  background-color: #1C1917;
  color: #FFFFFF;
}

/* 剪辑操作指南卡 */
.guide-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.guide-steps-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.guide-step-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.step-num-bubble {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #FFF7ED;
  color: #EA580C;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-desc {
  display: flex;
  flex-direction: column;
}

.step-heading {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1917;
}

.step-detail {
  font-size: 22rpx;
  color: #78716C;
  margin-top: 4rpx;
  line-height: 1.4;
}

.guide-footer-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #A8A29E;
  padding-top: 16rpx;
  border-top: 1px solid #F5F5F4;
}

/* ============================================================
   3. 上传 / 分析进度卡片 (Progress Card)
============================================================ */
.progress-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 40rpx 30rpx;
}

.progress-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.modern-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4px solid #F5F5F4;
  border-top-color: #FF6B00;
  border-radius: 50%;
  animation: modernSpin 0.75s linear infinite;
  flex-shrink: 0;
}

@keyframes modernSpin {
  to { transform: rotate(360deg); }
}

.progress-texts {
  display: flex;
  flex-direction: column;
}

.progress-title-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #1C1917;
}

.progress-file-text {
  font-size: 24rpx;
  color: #78716C;
  margin-top: 4rpx;
}

.progress-desc-box {
  background-color: #FAF9F6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.progress-step-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #EA580C;
}

.progress-hint {
  font-size: 20rpx;
  color: #A8A29E;
}

/* ============================================================
   4. 编辑态 (Editing Studio)
============================================================ */

/* 警告卡片 */
.warn-card {
  background-color: #FFFBEB;
  border: 1px solid #FDE68A;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.warn-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #92400E;
}

.warn-names {
  font-size: 24rpx;
  color: #B45309;
  font-weight: 600;
}

.warn-detail {
  font-size: 22rpx;
  color: #78350F;
}

.warn-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 6rpx;
}

.pill-btn.small {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
}

.banner-notice {
  background-color: #EFF6FF;
  border: 1px solid #BFDBFE;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #1E40AF;
}

/* 波形编辑器卡片 (Waveform Monitor & Precision Studio) */
.waveform-editor-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background-color: #FFFFFF;
}

.waveform-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time-readout {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.time-main {
  font-size: 40rpx;
  font-weight: 800;
  color: #1C1917;
  letter-spacing: -0.5rpx;
  font-family: monospace;
}

.time-total {
  font-size: 24rpx;
  color: #A8A29E;
  font-weight: 600;
  font-family: monospace;
}

.clip-locator-badge {
  background-color: #FFF7ED;
  border: 1px solid #FFEDD5;
  color: #EA580C;
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* Canvas 波形容器 (带标尺与触摸手势) */
.canvas-wrapper {
  background-color: #FAF8F5;
  border: 1px solid #E7E5E4;
  border-radius: 20rpx;
  overflow: hidden;
  height: 160rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.wave-canvas {
  width: 100%;
  height: 160rpx;
}

.canvas-fallback-tip {
  font-size: 22rpx;
  color: #A8A29E;
  text-align: center;
  padding: 6rpx 0;
}

.selection-status-row {
  min-height: 48rpx;
  display: flex;
  align-items: center;
}

.selection-active-chip {
  background-color: #FFF7ED;
  border: 1px solid #FFEDD5;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #EA580C;
}

.selection-idle-hint {
  font-size: 22rpx;
  color: #A8A29E;
}

.selection-razor-hint {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  background-color: #FEF2F2;
  border: 1.5rpx solid #FECACA;
  border-radius: 999rpx;
  padding: 6rpx 16rpx 6rpx 20rpx;
  animation: razorBannerIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  box-sizing: border-box;
}

.razor-pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #EF4444;
  animation: razorDotBlink 1.2s ease-in-out infinite;
  flex-shrink: 0;
  margin-right: 10rpx;
}

.razor-hint-text {
  font-size: 21rpx;
  color: #B91C1C;
  font-weight: 700;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.razor-exit-chip {
  padding: 4rpx 16rpx;
  background-color: #FFFFFF;
  border: 1px solid #FCA5A5;
  border-radius: 20rpx;
  font-size: 19rpx;
  font-weight: 700;
  color: #DC2626;
  flex-shrink: 0;
  margin-left: 12rpx;
  box-shadow: 0 1rpx 4rpx rgba(220, 38, 38, 0.1);
  transition: all 0.15s ease;
}

.razor-exit-chip:active {
  background-color: #FEE2E2;
  transform: scale(0.92);
}

@keyframes razorBannerIn {
  0% { opacity: 0; transform: translateY(-4rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes razorDotBlink {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.7); }
}

/* ============================================================
   统一精修控制中枢 (Unified Studio Command Console)
   彻底告别 6 个小方块并列拥挤与高低不一的粗糙感，实现 Apple 级严谨视觉对齐
============================================================ */
.studio-command-console {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 4rpx;
}

/* 第 1 栏：模式分段器 + 辅助工具组 (严格水平对齐，左右呼应) */
.console-mode-utility-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

/* iOS 风格模式分段胶囊 (选择模式 vs 剃刀切割) */
.mode-segmented-pill {
  flex: 1.05;
  display: flex;
  align-items: center;
  background-color: #F4F1EA;
  border: 1px solid #E6E2D8;
  border-radius: 20rpx;
  padding: 6rpx;
  height: 72rpx;
  box-sizing: border-box;
  gap: 6rpx;
}

.mode-segment-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 100%;
  border-radius: 15rpx;
  background: transparent;
  transition: all 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  box-sizing: border-box;
}

.mode-segment-item:active {
  transform: scale(0.94);
}

.segment-mono-icon {
  width: 28rpx;
  height: 28rpx;
  display: block;
  flex-shrink: 0;
  transition: opacity 0.2s ease;
}

.segment-text {
  font-size: 23rpx;
  font-weight: 700;
  color: #57534E;
  line-height: 1;
  white-space: nowrap;
}

/* 激活选择模式 */
.mode-segment-item.active-select {
  background-color: #1C1917;
  box-shadow: 0 4rpx 12rpx rgba(28, 25, 23, 0.22);
}

.mode-segment-item.active-select .segment-text {
  color: #FFFFFF;
  font-weight: 800;
}

/* 激活剃刀模式 */
.mode-segment-item.active-razor {
  background-color: #EF4444;
  box-shadow: 0 4rpx 14rpx rgba(239, 68, 68, 0.35);
}

.mode-segment-item.active-razor .segment-text {
  color: #FFFFFF;
  font-weight: 800;
}

.razor-active-dot {
  width: 8rpx;
  height: 8rpx;
  background-color: #FFFFFF;
  border-radius: 50%;
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  animation: razorDotBlink 1.2s ease-in-out infinite;
}

/* 右侧辅助工具胶囊组 (磁吸、归零、撤销：严谨等高、等宽、等距) */
.utility-pill-group {
  flex: 1.15;
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 72rpx;
  box-sizing: border-box;
}

.utility-pill-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 72rpx;
  background-color: #FAF9F6;
  border: 1px solid #E7E5E4;
  border-radius: 18rpx;
  box-sizing: border-box;
  padding: 0 4rpx;
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.utility-pill-btn:active:not(.disabled) {
  transform: scale(0.92);
  background-color: #EFECE6;
}

.utility-mono-icon {
  width: 26rpx;
  height: 26rpx;
  display: block;
  flex-shrink: 0;
  opacity: 0.85;
}

.utility-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #57534E;
  line-height: 1;
  white-space: nowrap;
}

/* 磁吸激活态 */
.utility-pill-btn.active-snap {
  background-color: #FFF7ED;
  border-color: #FFDBB5;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 0, 0.15);
}

.utility-pill-btn.active-snap .utility-text {
  color: #EA580C;
  font-weight: 800;
}

.utility-pill-btn.disabled {
  opacity: 0.35;
  pointer-events: none;
}

/* 第 2 栏：剪辑操作等宽对齐网格 (4 等分网格，统一 74rpx 高度，严密对称) */
.console-action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  width: 100%;
  box-sizing: border-box;
}

button.grid-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 74rpx;
  border-radius: 18rpx;
  background-color: #FAF9F6;
  border: 1px solid #E7E5E4;
  color: #1C1917;
  padding: 0 6rpx;
  box-sizing: border-box;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease, background-color 0.18s ease;
}

button.grid-action-btn:active:not(.disabled) {
  transform: scale(0.92) translateY(2rpx);
}

.action-mono-icon {
  width: 26rpx;
  height: 26rpx;
  display: block;
  flex-shrink: 0;
}

.action-label {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

/* 指针分割 (高亮强调) */
button.grid-action-btn.primary-cut {
  background: #FFF7ED;
  border-color: #FFDBB5;
  color: #EA580C;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 0, 0.12);
}

button.grid-action-btn.primary-cut .action-label {
  font-weight: 800;
}

/* 裁至选区 */
button.grid-action-btn.active-crop {
  background-color: #FAF9F6;
  border-color: #D6D3D1;
  color: #1C1917;
}

/* 删除选区 */
button.grid-action-btn.danger {
  background-color: #FEF2F2;
  border-color: #FECACA;
  color: #DC2626;
}

/* 全选本段 */
button.grid-action-btn.neutral {
  background-color: #FAF9F6;
  border-color: #E7E5E4;
  color: #57534E;
}

button.grid-action-btn.disabled {
  opacity: 0.38;
  pointer-events: none;
}

/* 第 3 栏：主控播放对称行 (88rpx 高度，双核完全对称) */
.console-transport-row {
  display: flex;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

button.transport-hero-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  padding: 0 16rpx;
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease, background-color 0.2s ease;
}

button.transport-hero-btn:active:not(.disabled) {
  transform: scale(0.94) translateY(2rpx);
}

.transport-hero-icon {
  width: 30rpx;
  height: 30rpx;
  display: block;
  flex-shrink: 0;
}

.transport-hero-text {
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
  white-space: nowrap;
}

button.transport-hero-btn.primary-all {
  background-color: #1C1917;
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(28, 25, 23, 0.22);
}

button.transport-hero-btn.primary-all.playing {
  animation: primaryPlayPulse 2.2s ease-in-out infinite;
}

button.transport-hero-btn.secondary-clip {
  background-color: #FFFFFF;
  border: 1.5rpx solid #E7E5E4;
  color: #1C1917;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

button.transport-hero-btn.secondary-clip.playing {
  border-color: #FFDBB5;
  background-color: #FFF7ED;
  color: #EA580C;
}

button.transport-hero-btn.disabled {
  opacity: 0.42;
  pointer-events: none;
}

/* 第 4 栏：微提示文案 */
.console-clarify-hint {
  font-size: 20rpx;
  color: #A8A29E;
  text-align: center;
  line-height: 1.4;
  margin-top: -2rpx;
}

/* 兼容历史类名，保证全局样式与测试健壮性 */
.fast-action-toolbar {
  composes: console-action-grid;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

button.fast-tool-btn {
  composes: grid-action-btn;
}

.transport-control-row {
  composes: console-transport-row;
  display: flex;
  gap: 12rpx;
}

button.transport-btn {
  composes: transport-hero-btn;
}

.nle-classic-toolbar {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.nle-bar-btn {
  composes: utility-pill-btn;
}

/* 兼容旧类名 */
.tool-mode-group,
.tool-action-group {
  display: contents;
}

.tool-btn,
.tool-icon-btn {
  composes: nle-bar-btn;
}

.tool-action-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tool-icon-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 14rpx;
  border-radius: 12rpx;
  background-color: #FFFFFF;
  border: 1px solid #E7E5E4;
  font-size: 20rpx;
  font-weight: 700;
  color: #57534E;
  transition: all 0.15s ease;
}

.tool-icon-btn.active {
  background-color: #FFF7ED;
  border-color: #FF6B00;
  color: #EA580C;
}

.tool-icon-btn.disabled {
  opacity: 0.35;
  pointer-events: none;
}

/* ============================================================
   6. 专业多音轨时间线与音频拼接工坊 (Multi-Track Splicing Studio)
============================================================ */
.nle-timeline-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #FFFFFF;
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
}

/* 顶部控制栏 (优化的双行高级专业布局) */
.timeline-top-toolbar {
  display: flex;
  flex-direction: column;
  padding: 8rpx 0 16rpx;
  border-bottom: 1px solid #F0EDE6;
  gap: 14rpx;
}

.toolbar-primary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.toolbar-secondary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  background: #FAF8F5;
  border: 1px solid #E7E5E4;
  border-radius: 14rpx;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
}

.timeline-title-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.timeline-main-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1C1917;
  letter-spacing: 0.5rpx;
}

.timeline-sub-meta {
  font-size: 20rpx;
  color: #78716C;
  font-weight: 600;
}

.mono-add-track-icon {
  width: 22rpx;
  height: 22rpx;
}

/* 缩放控制器 */
.timeline-zoom-controls {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #FAF8F5;
  padding: 4rpx 8rpx;
  border-radius: 14rpx;
  border: 1px solid #E7E5E4;
}

.zoom-stepper {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

button.zoom-step-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #FFFFFF;
  color: #1C1917;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  border: 1px solid #E7E5E4;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.15s ease;
}

button.zoom-step-btn:active:not([disabled]) {
  transform: scale(0.85);
  background: #F5F3EE;
}

button.zoom-step-btn[disabled] {
  opacity: 0.3;
}

.zoom-level-pill {
  padding: 4rpx 12rpx;
  background: #FFFFFF;
  border: 1px solid #E7E5E4;
  border-radius: 6rpx;
  min-width: 64rpx;
  text-align: center;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.zoom-level-pill:active {
  transform: scale(0.92);
}

.zoom-ratio-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #1C1917;
  font-family: monospace;
}

.zoom-preset-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.preset-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #78716C;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #F5F3EE;
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease, color 0.18s ease, box-shadow 0.2s ease;
}

.preset-tag:active {
  transform: scale(0.88);
}

.preset-tag.active {
  background: #1C1917;
  color: #FFFFFF;
  transform: scale(1.03);
  box-shadow: 0 2rpx 8rpx rgba(28, 25, 23, 0.2);
}

/* 新建音轨主按键 */
.add-track-pill-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #1C1917;
  color: #FFFFFF;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  box-shadow: 0 4rpx 14rpx rgba(28, 25, 23, 0.15);
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
}

.add-track-pill-btn:active {
  transform: scale(0.91) translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(28, 25, 23, 0.25);
  opacity: 0.94;
}

.add-track-pill-btn .add-icon {
  font-size: 26rpx;
  font-weight: 900;
}

/* 剃刀专属悬浮操作栏 (Floating Razor HUD Bar) */
.razor-mode-hud-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #1C1917 0%, #292524 100%);
  border: 1.5rpx solid #EF4444;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-top: 6rpx;
  box-shadow: 0 8rpx 24rpx rgba(239, 68, 68, 0.2);
  animation: hudSlideDown 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes hudSlideDown {
  0% { opacity: 0; transform: translateY(-10rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.razor-hud-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.razor-hud-mono-icon {
  width: 32rpx;
  height: 32rpx;
  padding: 8rpx;
  background-color: #EF4444;
  border-radius: 50%;
  flex-shrink: 0;
}

.razor-hud-texts {
  display: flex;
  flex-direction: column;
}

.razor-hud-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.razor-hud-desc {
  font-size: 19rpx;
  color: #A8A29E;
  margin-top: 2rpx;
}

.razor-hud-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.razor-hud-split-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: #EF4444;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  line-height: 1;
  border: none;
  box-shadow: 0 4rpx 10rpx rgba(239, 68, 68, 0.4);
}

.razor-hud-split-btn::after {
  display: none;
}

.razor-hud-split-btn:active {
  transform: scale(0.95);
  background-color: #DC2626;
}

.razor-hud-btn-icon {
  width: 22rpx;
  height: 22rpx;
}

.razor-hud-exit-btn {
  background-color: rgba(255, 255, 255, 0.12);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  line-height: 1;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.razor-hud-exit-btn::after {
  display: none;
}

.razor-hud-exit-btn:active {
  background-color: rgba(255, 255, 255, 0.2);
}

/* 统一机架装配体 (Sticky Headers + Synchronous Timeline) */
.nle-studio-assembly {
  display: flex;
  background: #FAF8F5;
  border: 1px solid #E7E5E4;
  border-radius: 20rpx;
  overflow: hidden;
}

/* 1. 左侧固定轨道头列 (Sticky Track Headers) */
.nle-sticky-headers-col {
  width: 170rpx;
  flex-shrink: 0;
  background: #F5F3EE;
  border-right: 1.5px solid #E7E5E4;
  display: flex;
  flex-direction: column;
  z-index: 5;
}

/* 标尺角标对齐方块（与时间标尺等高 48rpx） */
.nle-ruler-corner {
  height: 48rpx;
  background: #EFECE6;
  border-bottom: 1.5px solid #E5E1D8;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.corner-label {
  font-size: 18rpx;
  font-weight: 800;
  color: #78716C;
  letter-spacing: 2rpx;
}

/* 各固定音轨控制头 (Track Header Cells) - 与泳道等高 150rpx */
.nle-header-cell {
  height: 150rpx;
  border-bottom: 1px solid #E7E5E4;
  padding: 12rpx 10rpx 12rpx 12rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  background: #F5F3EE;
  transition: opacity 0.2s ease;
}

.nle-header-cell:last-child {
  border-bottom: none;
}

.nle-header-cell.muted {
  opacity: 0.45;
}

.track-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.track-title-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.track-color-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.track-name-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #1C1917;
  white-space: nowrap;
}

.track-del-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: rgba(239, 68, 68, 0.12);
  color: #DC2626;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.track-del-icon:active {
  background: #DC2626;
  color: #FFFFFF;
}

.track-header-mid {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.track-ctrl-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #57534E;
  background: #EAE6DE;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  border: 1px solid #DDD8CE;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  white-space: nowrap;
}

.track-ctrl-tag:active {
  transform: scale(0.88);
}

.track-ctrl-tag.active-mute {
  background: #FEE2E2;
  color: #DC2626;
  border-color: #FECACA;
  animation: pulseMute 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.track-ctrl-tag.active-duck {
  background: #FEF3C7;
  color: #B45309;
  border-color: #FDE68A;
  animation: pulseDuck 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.track-header-bottom {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.track-vol-chip {
  font-size: 18rpx;
  font-weight: 800;
  color: #1C1917;
  background: #FFFFFF;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  border: 1px solid #DDD8CE;
  font-family: monospace;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.15s ease;
  white-space: nowrap;
}

.track-vol-chip:active {
  background: #EAE6DE;
  transform: scale(0.88);
}

.track-mute-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #78716C;
  background: #EAE6DE;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  border: 1px solid #DDD8CE;
  transition: all 0.15s ease;
}

.track-mute-tag.active {
  background: #DC2626;
  color: #FFFFFF;
  border-color: #B91C1C;
}

.track-add-audio-chip {
  font-size: 18rpx;
  font-weight: 800;
  color: #1D4ED8;
  background: #EFF6FF;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  border: 1px solid #BFDBFE;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.15s ease;
  white-space: nowrap;
}

.track-add-audio-chip:active {
  background: #DBEAFE;
  transform: scale(0.88);
}

/* 2. 右侧全轨统一步进水平时间轴 */
.nle-timeline-scroll {
  flex: 1;
  width: 0;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  background: #FAF9F6;
}

.nle-timeline-surface {
  position: relative;
  min-height: 348rpx;
  box-sizing: border-box;
  transform: translateZ(0);
}

/* 双指缩放进行中：禁用所有过渡动画，GPU 硬加速，消除任何跟手延迟与卡顿 */
.nle-timeline-surface.pinching,
.nle-timeline-surface.pinching .nle-clip-card,
.nle-timeline-surface.pinching .ruler-tick-mark,
.nle-timeline-surface.pinching .nle-universal-playhead {
  transition: none !important;
  will-change: width, left;
}

/* 预设档位与步进缩放（全览 / 1x / 2x / + / -）：Apple 级物理减速丝滑镜头动画 */
.nle-timeline-surface.animating-zoom,
.nle-timeline-surface.animating-zoom .nle-clip-card,
.nle-timeline-surface.animating-zoom .ruler-tick-mark,
.nle-timeline-surface.animating-zoom .nle-universal-playhead {
  transition: width 0.36s cubic-bezier(0.16, 1, 0.3, 1),
              left 0.36s cubic-bezier(0.16, 1, 0.3, 1) !important;
  will-change: width, left;
}

/* 实时拖拽/拖动裁剪指示吸顶药丸 (Active Dragging / Trimming Floating Pill) */
.timeline-drag-floating-pill {
  position: absolute;
  top: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #1C1917;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 800;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(28, 25, 23, 0.35), 0 0 0 2rpx rgba(255, 107, 0, 0.5);
  display: flex;
  align-items: center;
  gap: 8rpx;
  z-index: 40;
  pointer-events: none;
  white-space: nowrap;
  animation: springPillPop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) forwards, pillHoverBob 2s ease-in-out 0.32s infinite alternate;
}

.drag-pill-icon {
  font-size: 22rpx;
}

.drag-pill-text {
  letter-spacing: 0.5rpx;
}

.timeline-drag-floating-pill.pinch-pill {
  background: #1C1917;
  border: 1.5rpx solid #FF6B00;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 0, 0.4), 0 0 0 2rpx rgba(255, 107, 0, 0.5);
  z-index: 120;
}

/* 播放中用户手动滑动浏览后续内容时，提供一键回随指针悬浮药丸 */
.timeline-drag-floating-pill.resume-follow-pill {
  background: #1C1917;
  border: 1.5rpx solid #3B82F6;
  box-shadow: 0 8rpx 32rpx rgba(59, 130, 246, 0.4), 0 0 0 2rpx rgba(59, 130, 246, 0.5);
  pointer-events: auto !important;
  cursor: pointer;
  z-index: 125;
}

.timeline-drag-floating-pill.resume-follow-pill:active {
  transform: translateX(-50%) scale(0.94);
  opacity: 0.9;
}

/* 顶部统一步进时间标尺 */
.nle-unified-ruler {
  position: relative;
  height: 48rpx;
  background: #EFECE6;
  border-bottom: 1.5px solid #E5E1D8;
  box-sizing: border-box;
}

.ruler-tick-mark {
  position: absolute;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  pointer-events: auto;
  padding-left: 2rpx;
}

.tick-line {
  width: 2rpx;
  height: 12rpx;
  background: #CBD5E1;
}

.tick-label {
  font-size: 18rpx;
  font-family: monospace;
  color: #78716C;
  font-weight: 600;
  transform: scale(0.9);
  transform-origin: left top;
  margin-top: 2rpx;
}

/* 10 分钟导出限额界标与标尺刻度 */
.ruler-ceiling-marker {
  position: absolute;
  top: 0;
  bottom: 0;
  z-index: 15;
  pointer-events: none;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ceiling-pill {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #EF4444;
  color: #FFFFFF;
  font-size: 17rpx;
  font-weight: 800;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.4);
  white-space: nowrap;
}

.ceiling-pill-icon {
  font-size: 16rpx;
}

.ceiling-ruler-tick {
  width: 3rpx;
  height: 14rpx;
  background: #EF4444;
  margin-top: 2rpx;
}

/* 贯穿全泳道的 10 分钟警戒线 */
.tracks-ceiling-divider {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  z-index: 12;
  pointer-events: none;
  transform: translateX(-50%);
}

.ceiling-vertical-line {
  width: 100%;
  height: 100%;
  border-left: 2rpx dashed #EF4444;
  opacity: 0.85;
}

/* 超出 10 分钟的警戒遮罩斜条纹背景 */
.tracks-over-ceiling-zone {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  background: repeating-linear-gradient(
    45deg,
    rgba(239, 68, 68, 0.05),
    rgba(239, 68, 68, 0.05) 12rpx,
    transparent 12rpx,
    transparent 24rpx
  );
  pointer-events: none;
  z-index: 1;
}

/* 轨道泳道容器 */
.nle-tracks-canvas {
  position: relative;
}

.nle-track-lane {
  position: relative;
  height: 150rpx;
  border-bottom: 1px solid #EFECE6;
  box-sizing: border-box;
  background: #FAF9F6;
  transition: opacity 0.2s ease;
}

.nle-track-lane:last-child {
  border-bottom: none;
}

.nle-track-lane.muted {
  opacity: 0.45;
}

.lane-grid-bg {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: rgba(0, 0, 0, 0.03);
}

/* 空轨道大卡片引导 (Dropzone) */
.empty-track-dropzone {
  position: absolute;
  top: 14rpx;
  bottom: 14rpx;
  left: 14rpx;
  right: 40rpx;
  border: 1.5px dashed #CBD5E1;
  border-radius: 14rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #64748B;
  transition: all 0.15s ease;
}

.empty-track-dropzone:active {
  background: rgba(59, 130, 246, 0.08);
  border-color: #3B82F6;
  color: #1D4ED8;
}

.dropzone-plus {
  font-size: 28rpx;
  font-weight: 900;
}

.dropzone-text {
  font-size: 22rpx;
  font-weight: 700;
}

/* 片段摆放绝对定位层 */
.lane-clips-layer {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  left: 0;
  right: 0;
}

/* 片段卡块：现代精美音频卡 (带物理弹簧过渡与最小触控热区) */
.nle-clip-card {
  position: absolute;
  top: 0;
  bottom: 0;
  min-width: 60rpx !important;
  border-radius: 14rpx;
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
  cursor: pointer;
  background: #FFFFFF;
  border: 1.5px solid #CBD5E1;
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.22s ease, border-color 0.2s ease;
  overflow: visible;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
}

/* 触控扩充判定区：在移动端保障 <0.5s 微残片也能轻松被粗手指点中与操作 */
.nle-clip-card::before {
  content: '';
  position: absolute;
  top: -12rpx;
  bottom: -12rpx;
  left: -12rpx;
  right: -12rpx;
  z-index: 1;
  pointer-events: auto;
}

.nle-clip-card:active {
  transform: scale(0.97) translateY(2rpx);
}

/* 选中高亮状态：发光纯金边框 + 外辉光 + 微弹就位 */
.nle-clip-card.selected {
  border-color: #FF6B00 !important;
  box-shadow: 0 0 20rpx rgba(255, 107, 0, 0.38), inset 0 0 8rpx rgba(255, 107, 0, 0.1) !important;
  z-index: 10;
  animation: cardSelectPop 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 拖拽高浮起状态：高亮大阴影，丝滑跟手 */
.nle-clip-card.dragging {
  z-index: 100 !important;
  opacity: 0.98;
  transform: scale(1.04) translateY(-4rpx);
  box-shadow: 0 16rpx 40rpx rgba(255, 107, 0, 0.5), 0 0 0 3rpx #FF6B00 !important;
  transition: none !important;
}

/* 裁剪高亮状态：左右把手拖动裁剪 */
.nle-clip-card.trimming {
  z-index: 95 !important;
  border-color: #FF6B00 !important;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 0, 0.45) !important;
  transition: none !important;
}

/* 同轨片段重叠碰撞警戒状态 */
.nle-clip-card.is-overlapping {
  border-style: dashed !important;
  border-width: 3rpx !important;
  border-color: #F59E0B !important;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFBEB 100%) !important;
  box-shadow: 0 4rpx 16rpx rgba(245, 158, 11, 0.25) !important;
}

.clip-overlap-badge {
  position: absolute;
  top: -16rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #F59E0B;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 800;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 10rpx rgba(245, 158, 11, 0.4);
  z-index: 25;
  pointer-events: none;
  white-space: nowrap;
}

.clip-overlap-badge .badge-icon {
  font-size: 16rpx;
}

/* 剃刀武装状态下的片段卡片 (Dashed Red Border + Crosshair) */
.nle-clip-card.razor-armed {
  border-style: dashed !important;
  border-width: 3rpx !important;
  border-color: #EF4444 !important;
  cursor: crosshair;
}

.clip-razor-scissor-tag {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  background-color: rgba(239, 68, 68, 0.92);
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  pointer-events: none;
  z-index: 20;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.4);
}

.clip-scissor-mini-icon {
  width: 20rpx;
  height: 20rpx;
}

/* 刚被剃刀切开的瞬间闪光反馈动画 (Seam Cut Flash) */
.nle-clip-card.just-split {
  animation: seamCutFlash 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes seamCutFlash {
  0% {
    box-shadow: 0 0 0 6rpx #EF4444, 0 0 28rpx rgba(239, 68, 68, 0.85);
    transform: scale(1.02);
  }
  100% {
    box-shadow: none;
    transform: scale(1);
  }
}

/* 选中入点/出点修剪把手 (Trim Handles) - 支持触摸拖动 */
.trim-handle {
  width: 32rpx;
  position: relative;
  background: #FF6B00;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 15;
  box-shadow: 0 0 10rpx rgba(255, 107, 0, 0.45);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.18s ease;
}

.trim-handle.active {
  background: #FF8500;
  animation: handlePulseGlow 0.8s ease-in-out infinite alternate;
  transform: scaleY(1.08) scaleX(1.15);
}

.trim-handle::after {
  content: '';
  position: absolute;
  top: -24rpx;
  bottom: -24rpx;
  left: -20rpx;
  right: -20rpx;
}

.trim-handle.trim-in {
  border-radius: 12rpx 0 0 12rpx;
}

.trim-handle.trim-out {
  border-radius: 0 12rpx 12rpx 0;
}

.trim-grip-bars {
  display: flex;
  align-items: center;
  gap: 3rpx;
}

.trim-bar {
  width: 3rpx;
  height: 28rpx;
  border-radius: 2rpx;
  background: #FFFFFF;
}

/* 片段内部卡片主体 */
.clip-card-body {
  position: relative;
  flex: 1;
  width: 100%;
  height: 100%;
  padding: 8rpx 10rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  overflow: hidden;
}

.clip-top-line {
  position: sticky;
  left: 8rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  max-width: 280rpx;
  z-index: 5;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(8px);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  border: 1px solid rgba(0, 0, 0, 0.06);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  white-space: nowrap;
}

/* 重复/切开分段专属：仅展现 🎵 标记，不展现冗余文字 */
.clip-mark-only-tag {
  position: sticky;
  left: 6rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  z-index: 5;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(8px);
  border-radius: 8rpx;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.05);
}

.clip-mark-icon {
  font-size: 20rpx;
  line-height: 1;
}

.nle-clip-card.selected .clip-mark-only-tag {
  border-color: #FF6B00;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 0, 0.22);
}

.clip-name-text {
  font-size: 21rpx;
  font-weight: 700;
  color: #1C1917;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 180rpx;
}

.clip-time-text {
  font-size: 19rpx;
  font-weight: 700;
  color: #78716C;
  font-family: monospace;
}

/* 真实声波微缩切片 (Timeline Full-Span Dense Waveform Slice，放大后全幅无死角自适应满铺) */
.clip-wave-bars {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 48rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 0 4rpx;
  overflow: hidden;
}

.cw-bar {
  flex: 1 1 0%;
  min-width: 2rpx;
  margin: 0 1rpx;
  border-radius: 2rpx;
  background-color: #94A3B8;
  height: 40%;
}

.nle-clip-card.selected .cw-bar {
  background-color: #FF6B00;
}

/* 底部状态小标签 */
.clip-footer-tags {
  position: sticky;
  left: 8rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  max-width: 280rpx;
  z-index: 5;
  overflow: hidden;
  white-space: nowrap;
}

.clip-grip-hint {
  font-size: 15rpx;
  font-weight: 800;
  color: #78716C;
  background: #F5F3EE;
  padding: 1rpx 6rpx;
  border-radius: 4rpx;
  white-space: nowrap;
}

.clip-mini-tag {
  font-size: 16rpx;
  font-weight: 700;
  padding: 1rpx 8rpx;
  border-radius: 4rpx;
  background: #F0EDE6;
  color: #57534E;
  white-space: nowrap;
}

.clip-gold-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #FF6B00, #FFA14A, #FF6B00);
  background-size: 200% 100%;
  animation: goldGlowFlow 2.5s ease-in-out infinite;
}

/* 轨道尾部拼入音频按钮 (Append Audio Button) */
.append-audio-btn {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  width: 140rpx;
  border: 1.5px dashed #CBD5E1;
  border-radius: 14rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #64748B;
  box-sizing: border-box;
  transition: transform 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.15s ease, border-color 0.15s ease;
}

.append-audio-btn:active {
  background: rgba(59, 130, 246, 0.08);
  border-color: #3B82F6;
  color: #1D4ED8;
  transform: scale(0.92);
}

.append-icon {
  font-size: 26rpx;
  font-weight: 900;
}

.append-label {
  font-size: 18rpx;
  font-weight: 700;
}

/* 贯穿全轨的红色播放指针 (Signal Red CTI Needle) */
.nle-universal-playhead {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  z-index: 25;
  pointer-events: none;
  transform: translateX(-50%);
  will-change: left;
}

.playhead-cap {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 14rpx solid #FF3B30;
  filter: drop-shadow(0 2rpx 4rpx rgba(255, 59, 48, 0.6));
  transition: transform 0.2s ease;
}

.playhead-line {
  position: absolute;
  top: 14rpx;
  bottom: 0;
  left: 50%;
  width: 2rpx;
  background: #FF3B30;
  transform: translateX(-50%);
  box-shadow: 0 0 6rpx rgba(255, 59, 48, 0.5);
  transition: box-shadow 0.2s ease;
}

/* 播放中指针激光辉光效果 */
.nle-universal-playhead.playing .playhead-cap {
  animation: playheadLaserPulse 1s ease-in-out infinite alternate;
}

.nle-universal-playhead.playing .playhead-line {
  animation: playheadBeamGlow 1s ease-in-out infinite alternate;
}

/* 3. 选中片段高频拼接操作栏 (Splicing & Clip Operations) */
.clip-splicing-action-bar {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  background: #FAF8F5;
  border: 1px solid #E7E5E4;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

/* 片段碰撞重叠处置横幅 */
.clip-overlap-alert-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  background: #FFFBEB;
  border: 1.5rpx solid #FDE68A;
  border-radius: 14rpx;
  padding: 10rpx 16rpx;
  margin-bottom: 4rpx;
}

.overlap-alert-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.overlap-alert-left .alert-icon {
  font-size: 26rpx;
  flex-shrink: 0;
}

.alert-info-col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.alert-info-col .alert-title {
  font-size: 21rpx;
  font-weight: 800;
  color: #B45309;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.alert-info-col .alert-desc {
  font-size: 18rpx;
  color: #D97706;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.overlap-alert-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.alert-action-btn {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
  cursor: pointer;
  transition: all 0.15s ease;
}

.alert-action-btn:active {
  transform: scale(0.94);
}

.alert-action-btn.stagger {
  background: #F59E0B;
  color: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.35);
}

.alert-action-btn.new-track {
  background: #FFFFFF;
  color: #B45309;
  border: 1rpx solid #FCD34D;
}

.splicing-bar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #EFECE6;
  padding-bottom: 14rpx;
  gap: 12rpx;
}

.selected-clip-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.track-tag-pill {
  background: #ECE8E1;
  color: #44403C;
  font-size: 19rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  letter-spacing: 0.5rpx;
}

.clip-badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
