/* miniprogram/pages/settings/settings.wxss */
page {
  background: #F8F6F2;
  color: #1C1917;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Rounded", "SF Pro Display", "PingFang SC", "Segoe UI", Roboto, sans-serif;
}
.page {
  padding: 28rpx 28rpx 60rpx;
}
.card {
  background: #FFFFFF;
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 28rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
}
.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1C1917;
  padding: 20rpx 0 10rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-top: 1px solid #F5F5F4;
  font-size: 28rpx;
  color: #1C1917;
}
.row-value {
  color: #78716C;
  font-size: 26rpx;
  font-weight: 500;
}
.link:active {
  opacity: 0.7;
}
.link .arrow {
  color: #A8A29E;
  font-size: 34rpx;
}
.hint {
  font-size: 22rpx;
  color: #78716C;
  line-height: 1.6;
  padding: 10rpx 0 20rpx;
}
.footer {
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
  color: #A8A29E;
  margin-top: 24rpx;
}
